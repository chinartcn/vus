#// 控件库总览演示 —— Git 拉取后运行即可看到全部控件真实样子
#//
#//   用 图形_* 内建函数搭建一张示例界面，展示当前控件库支持的所有控件：
#//   标签、文本框、复选框、进度条、按钮、文字列表、画布。
#//
#// 运行：Termux + Termux-X11 已启动时
#//     cd ~/.vus
#//     ./vus run examples/gui_controls_demo.vus
#// 窗口出现后可用鼠标/触摸点击：选列表项、点复选框、点画布、点按钮，
#// 命中结果会实时打印在运行那个终端里。

打印("控件库总览：界面已显示，点击列表/复选框/画布/按钮试试\n")

# 窗口 360x260
图形_初始化(360, 260, "控件库总览")

# ---- 标题（标签）----
图形_标签("标题", 12, 8, "VUS 图形控件库", 0x0055AA)
图形_标签("副标题", 12, 24, "点击下面的控件试试", 0x888888)

# ---- 文本框（显示区，尚未接入键盘）----
图形_文本框("输入框", 130, 8, 120, 22, "这是文本框")

# ---- 复选框（点击切换勾选）----
图形_复选框("记住我", 12, 52, "记住我", 0)

# ---- 进度条（静态演示 60%）----
图形_进度("加载", 12, 76, 150, 18, 60)
图形_标签("进度值", 170, 76, "60%", 0x228B22)

# ---- 按钮（命中检测）----
图形_按钮("确定", 12, 106, 80, 30, "确定")

# ---- 文字列表（点击行高亮、可取选中行号）----
图形_列表("菜单", 230, 8, 118, 140, 18)
图形_列表行("菜单", 0, "1. 主界面")
图形_列表行("菜单", 1, "2. 设置")
图形_列表行("菜单", 2, "3. 关于")
图形_列表行("菜单", 3, "4. 帮助")
图形_列表行("菜单", 4, "5. 退出")
图形_标签("右侧列表", 230, 152, "这是列表", 0x888888)

# ---- 画布（区域内自由绘制，可命中并取相对坐标）----
图形_画布("绘图", 12, 152, 200, 90)
# 画布内画：横轴、斜线、圆点序列
图形_画线(20, 200, 200, 170, 0xB0B0B0)   # 斜轴
图形_画线(20, 176, 200, 176, 0x555555)   # 中心横线
循环 画点 从 0 到 4:
    图形_画点(30 + 画点 * 32, 200 - 画点 * 6, 0xFF8800)
图形_标签("这是画布", 72, 228, "画布区可点出相对坐标", 0xBBBBBB)

图形_刷新()

# ---- 交互轮询：点击任意控件，把命中结果打印到终端 ----
# 注意：轮询模型读取的是"最近一次点击坐标"，同一次点击会被重复读到，
# 脚本若要"只处理一次"需自行消费；此处演示为主，重复打印不影响观看。
# 循环体内使用的变量需先初始化，才能在生成的 C 中得到声明
勾 = 0
行号 = "-1"
点 = "-1,-1"
计数 = 0
当循环 计数 < 600:   # 约 10 秒提示窗；真机把 600 调大，或改成 真 无限循环
    图形_取事件()

    如果 图形_按钮点击("确定"):
        打印("[事件] 你点了确定按钮\n")

    勾 = 图形_复选框("记住我", 12, 52, "记住我", 0)
    如果 勾:
        打印("[事件] 记住了！复选框已勾选\n")

    行号 = 图形_列表选中("菜单")
    如果 行号 != "-1":
        打印("[事件] 选中列表第 ")
        打印(行号)
        打印(" 项\n")

    如果 图形_画布命中("绘图"):
        点 = 图形_画布点("绘图")
        打印("[事件] 画布命中，相对坐标 ")
        打印(点)
        打印("\n")

    计数 = 计数 + 1

图形_保持()
打印("演示结束\n")