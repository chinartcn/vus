# 图形界面源码（由 HTML 高级排版设计器导出）
# 首行参数说明：图形_初始化(逻辑宽度, 逻辑高度, 窗口标题)

图形_初始化(480, 320, "我的界面")
图形_主题(0xFFFFFF, 0x888888, 0x0055AA, 0x333333, 0x000000)
图形_外观(8)

# 控件：t1（label）
图形_文字(20, 10, "你好", 0x000000)
# 控件：b1（button）
图形_按钮("b1", 20, 40, 120, 36, "确定")
# 控件：s1（slider）
图形_滑块("s1", 20, 90, 160, 50, 0, 100)
# 控件：sw1（switch）
图形_开关("sw1", 20, 120, 1)
# 控件：sp1（spin）
图形_微调("sp1", 20, 150, 3, 1)
# 控件：r1（radio）
图形_单选("r1", 20, 180, 20, "红;绿;蓝", 0)
# 控件：rr（round_rect）
图形_圆角矩形(200, 40, 120, 60, 8, 0xE0E0E0)
# 控件：fr（fill_rect）
图形_填充(200, 110, 120, 60, 0xCCEEFF)
# 控件：c1（circle）
图形_画圆(260, 210, 30, 0xFF8800)
# 控件：fc（fill_circle）
图形_填充圆(330, 210, 30, 0x44AA44)
# 控件：a1（arc）
图形_圆弧(400, 210, 24, 0, 270, 0x666666)
# 控件：p1（progress）
图形_进度("p1", 20, 240, 200, 18, 72)
# 控件：tb1（textbox）
图形_文本框("tb1", 20, 280, 160, 30, "文本框")

图形_刷新()
# 共 13 个控件，界面设计完成。
