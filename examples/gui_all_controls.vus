#// VUS GUI 全控件示例 —— 一张界面覆盖当前控件库的全部控件与高级外观
#//
#// 展示：标签/文本框/按钮/复选框/进度条/列表/画布（基础控件）
#//     滑块/开关/微调/单选（高级交互控件）
#//     圆角矩形/圆角填充/画圆/填充圆/圆弧（高级外观）
#//     图形_图片（PNG/SVG/GIF）与 图形_外观 全局圆角
#//
#// 运行（Termux + Termux-X11 已启动时）：
#//     ./vus run examples/gui_all_controls.vus
#// 窗口出现后可用鼠标/触摸拖动滑块、点开关/微调/单选，命中结果实时打印。

打印("VUS 全控件示例：拖动滑块 / 点开关 / 增减微调试试\n")

# 窗口 480x360，全局圆角 8，浅色主题
图形_初始化(480, 360, "VUS 全控件示例")
图形_外观(8)
图形_主题(0xFBFAF8, 0xAAAAAA, 0x0B5FD0, 0x333333, 0x1A1A1A)

# ==================== 基础控件 ====================
图形_标签("标题", 12, 10, "基础控件", 0x0B5FD0)
图形_文本框("输入", 12, 32, 150, 24, "这是文本框")
图形_按钮("确定", 172, 32, 84, 24, "确定")
图形_复选框("记住", 12, 62, "记住我", 1)
图形_进度("加载", 12, 86, 150, 16, 72)

# 列表（点击行高亮、可取选中行号）
图形_列表("菜单", 12, 114, 200, 148, 18)
图形_列表行("菜单", 0, "1. 主界面")
图形_列表行("菜单", 1, "2. 设置")
图形_列表行("菜单", 2, "3. 关于")
图形_列表行("菜单", 3, "4. 帮助")
图形_列表行("菜单", 4, "5. 退出")

# 画布（底部横条，区域内自由绘制 + 命中取相对坐标）
图形_画布("绘图", 12, 272, 456, 36)
图形_画线(12, 290, 468, 290, 0xBBBBBB)
循环 点 从 0 到 7:
    图形_画点(24 + 点 * 56, 290 - ((点 % 3) * 6), 0xFF8800)

# ==================== 高级交互控件（外观圆角） ====================
图形_标签("高级标题", 250, 10, "高级控件 / 外观", 0x0B5FD0)
图形_滑块("音量", 250, 30, 186, 50)
图形_开关("电源", 250, 56, 1)
图形_微调("步数", 250, 82, 5, 1)
图形_单选("颜色", 250, 112, 20, "红;绿;蓝;白", 1)

# ==================== 高级外观：圆角矩形 / 圆 / 圆弧 ====================
图形_圆角矩形(250, 190, 88, 36, 12, 0xE07020)
图形_圆角填充(346, 190, 88, 36, 12, 0x2E8B57)
图形_画圆(288, 252, 16, 0x0B5FD0)
图形_填充圆(348, 252, 16, 0xFF8800)
图形_圆弧(408, 252, 16, 0, 270, 0x8A2BE2)

# 图片：缺失/路径不符时返回 0，不崩溃（若无图可删此行）
图形_图片(408, 10, 56, 56, "examples/green.png")

图形_刷新()

# ==================== 读取当前值并打印 ====================
音量值 = "50"
开关值 = "true"
微调值 = "5"
单选值 = "1"

打印("--- 各控件当前值 ---\n")
打印("滑块值 = ")
音量值 = 图形_滑块值("音量")
打印(音量值)
打印("\n开关值 = ")
开关值 = 图形_开关值("电源")
打印(开关值)
打印("\n微调值 = ")
微调值 = 图形_微调值("步数")
打印(微调值)
打印("\n单选选中 = ")
单选值 = 图形_单选值("颜色")
打印(单选值)
打印("（索引，0=红）\n")

# ==================== 交互轮询（真机拖动滑块可实时看到变化） ====================
计数 = 0
勾选 = 0
行号 = "-1"
点串 = "-1,-1"
当循环 计数 < 900:   # 约 30 秒；真机改大或改 真 无限
    图形_取事件()

    如果 图形_按钮点击("确定"):
        打印("[事件] 点了确定按钮\n")

    勾选 = 图形_复选框("记住", 12, 62, "记住我", 0)

    音量值 = 图形_滑块("音量", 250, 30, 186, 50)
    开关值 = 图形_开关("电源", 250, 56, 0)
    微调值 = 图形_微调("步数", 250, 82, 5, 1)
    单选值 = 图形_单选("颜色", 250, 112, 20, "红;绿;蓝;白", 0)

    行号 = 图形_列表选中("菜单")
    如果 行号 != "-1":
        打印("[事件] 选中列表第 ")
        打印(行号)
        打印(" 项\n")

    如果 图形_画布命中("绘图"):
        点串 = 图形_画布点("绘图")
        打印("[事件] 画布相对坐标 ")
        打印(点串)
        打印("\n")

    图形_刷新()
    计数 = 计数 + 1

图形_刷新()
打印("示例结束\n")