{
    "type": "界面",
    "标题": "主页",
    "子组件": [
        {
            "type": "文本",
            "内容": "你好，VUS + VUA Android"
        },
        {
            "type": "按钮",
            "id": "btn_logic",
            "文字": "打开逻辑测试",
            "事件": {
                "事件名": "打开逻辑",
                "回调变量": []
            }
        },
        {
            "type": "按钮",
            "id": "btn1",
            "文字": "打开设置",
            "事件": {
                "事件名": "打开设置",
                "回调变量": []
            }
        },
        {
            "type": "按钮",
            "id": "btn_update",
            "文字": "检查更新",
            "事件": {
                "事件名": "检查更新"
            }
        },
        {
            "type": "输入框",
            "id": "in1",
            "variable": "备注",
            "标签": "备注",
            "提示": "输入备注"
        },
        {
            "type": "文本",
            "内容": "以下为 .vaz 示例：搜索条(自定义复合控件，构建期展开)"
        },
        {
            "type": "行",
            "子组件": [
                {
                    "type": "输入框",
                    "id": "sb1_关键词",
                    "variable": "关键词",
                    "标签": "搜索",
                    "提示": "输入要搜索的内容"
                },
                {
                    "type": "按钮",
                    "id": "sb1_搜索",
                    "文字": "搜一搜",
                    "事件": {
                        "事件名": "执行搜索",
                        "回调变量": [
                            "关键词"
                        ]
                    }
                }
            ]
        },
        {
            "type": "文本",
            "内容": "星级评分(点击 ★ 调整，构建期展开)"
        },
        {
            "type": "行",
            "子组件": [
                {
                    "type": "按钮",
                    "id": "rate1_星1",
                    "文字": "★",
                    "事件": {
                        "事件名": "调整星级",
                        "回调变量": [
                            "星级",
                            "1"
                        ]
                    }
                },
                {
                    "type": "按钮",
                    "id": "rate1_星2",
                    "文字": "★",
                    "事件": {
                        "事件名": "调整星级",
                        "回调变量": [
                            "星级",
                            "2"
                        ]
                    }
                },
                {
                    "type": "按钮",
                    "id": "rate1_星3",
                    "文字": "★",
                    "事件": {
                        "事件名": "调整星级",
                        "回调变量": [
                            "星级",
                            "3"
                        ]
                    }
                },
                {
                    "type": "按钮",
                    "id": "rate1_星4",
                    "文字": "★",
                    "事件": {
                        "事件名": "调整星级",
                        "回调变量": [
                            "星级",
                            "4"
                        ]
                    }
                },
                {
                    "type": "按钮",
                    "id": "rate1_星5",
                    "文字": "★",
                    "事件": {
                        "事件名": "调整星级",
                        "回调变量": [
                            "星级",
                            "5"
                        ]
                    }
                }
            ]
        }
    ]
}