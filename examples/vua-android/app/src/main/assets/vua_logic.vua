{
  "type": "界面",
  "标题": "逻辑测试",
  "子组件": [
    { "type": "文本", "内容": "计数演示（VUS 状态逻辑）", "样式": "title" },
    { "type": "文本", "variable": "计数", "内容": "0", "样式": "headline" },
    { "type": "行", "子组件": [
      { "type": "按钮", "id": "b_inc", "文字": "加1", "事件": { "事件名": "加1" } },
      { "type": "按钮", "id": "b_dec", "文字": "减1", "事件": { "事件名": "减1" } },
      { "type": "按钮", "id": "b_dbl", "文字": "翻倍", "事件": { "事件名": "翻倍" } },
      { "type": "按钮", "id": "b_clr", "文字": "清零", "事件": { "事件名": "清零" } }
    ]},
    { "type": "按钮", "id": "b_par", "文字": "检查奇偶", "事件": { "事件名": "检查奇偶" } },
    { "type": "文本", "variable": "奇偶", "内容": "?" },
    { "type": "输入框", "id": "in_note", "variable": "备注", "标签": "备注", "提示": "输入任意文本" },
    { "type": "文本", "内容": "--- 新控件演示 ---", "样式": "title" },
    { "type": "滑块", "variable": "音量", "标签": "音量", "最小值": 0, "最大值": 100, "值": 50 },
    { "type": "下拉", "variable": "选项", "标签": "选择项", "选项": ["选项A", "选项B", "选项C"] },
    { "type": "图片", "src": "sample_logo.jpg" },
    { "type": "文本", "内容": "--- DEX 逻辑拓展演示 ---", "样式": "title" },
    { "type": "行", "子组件": [
      { "type": "按钮", "id": "b_ext", "文字": "拓展求和 11+22", "事件": { "事件名": "拓展求和" } },
      { "type": "按钮", "id": "b_ext2", "文字": "拓展阶乘 10!", "事件": { "事件名": "拓展阶乘" } }
    ]},
    { "type": "文本", "variable": "拓展结果", "内容": "未调用" },
    { "type": "按钮", "id": "b_back", "文字": "返回主页", "事件": { "事件名": "返回主页" } }
  ]
}