{
    "type": "界面",
    "标题": "主题演示",
    "子组件": [
        {
            "type": "文本",
            "内容": "运行期主题切换（主题_设置）",
            "样式": "title"
        },
        {
            "type": "行",
            "子组件": [
                {
                    "type": "按钮",
                    "id": "btn_light",
                    "文字": "浅色",
                    "事件": {
                        "事件名": "切浅色",
                        "回调变量": []
                    }
                },
                {
                    "type": "按钮",
                    "id": "btn_dark",
                    "文字": "暗色",
                    "事件": {
                        "事件名": "切暗色",
                        "回调变量": []
                    }
                },
                {
                    "type": "按钮",
                    "id": "btn_sys",
                    "文字": "跟随系统",
                    "事件": {
                        "事件名": "切系统",
                        "回调变量": []
                    }
                }
            ]
        },
        {
            "type": "文本",
            "variable": "主题状态",
            "内容": "当前：浅色 · 本页未声明主题",
            "样式": "caption"
        },
        {
            "type": "行",
            "子组件": [
                {
                    "type": "按钮",
                    "id": "btn_p_dyn",
                    "文字": "动态取色",
                    "事件": {
                        "事件名": "主色动态",
                        "回调变量": []
                    }
                },
                {
                    "type": "按钮",
                    "id": "btn_p_green",
                    "文字": "活力绿",
                    "事件": {
                        "事件名": "主色绿",
                        "回调变量": []
                    }
                },
                {
                    "type": "按钮",
                    "id": "btn_p_blue",
                    "文字": "默认蓝",
                    "事件": {
                        "事件名": "主色默认",
                        "回调变量": []
                    }
                }
            ]
        },
        {
            "type": "文本",
            "variable": "主色状态",
            "内容": "主色：#2962FF（默认品牌蓝）",
            "样式": "caption"
        },
        {
            "type": "分隔线"
        },
        {
            "type": "文本",
            "内容": "新组件演示",
            "样式": "title"
        },
        {
            "type": "文本",
            "内容": "进度条（值/最大值/颜色/百分比）",
            "样式": "caption"
        },
        {
            "type": "进度条",
            "值": 65,
            "最大值": 100,
            "颜色": "0x4CAF50",
            "百分比": 1
        },
        {
            "type": "间距",
            "高": 6
        },
        {
            "type": "进度条",
            "值": 30,
            "最大值": 50,
            "颜色": "#FF7043"
        },
        {
            "type": "间距",
            "高": 10
        },
        {
            "type": "分隔线",
            "上边距": 6,
            "下边距": 6
        },
        {
            "type": "开关",
            "id": "sw_theme",
            "标签": "开关（Switch）",
            "variable": "开关值"
        },
        {
            "type": "滑块",
            "id": "sl_theme",
            "标签": "滑块（SeekBar）",
            "variable": "滑块值"
        },
        {
            "type": "下拉",
            "id": "sp_theme",
            "标签": "下拉（Spinner）",
            "variable": "下拉值",
            "选项": [
                "英语",
                "数学",
                "物理",
                "化学"
            ]
        },
        {
            "type": "文本",
            "内容": "复选框用于多选",
            "样式": "caption"
        },
        {
            "type": "复选框",
            "id": "cb1",
            "标签": "已读并同意",
            "variable": "同意值"
        },
        {
            "type": "间距",
            "高": 10
        },
        {
            "type": "分隔线"
        },
        {
            "type": "按钮",
            "id": "btn_back_theme",
            "文字": "返回主页",
            "事件": {
                "事件名": "返回主页",
                "回调变量": []
            }
        }
    ]
}