<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 风格（平台内置 DeviceDefault：Android 12+ 系统组件天然 MD3 观感）。
         深浅主题由渲染树/主题_设置 自绘控制，故固定 Light 父主题避免与脚本冲突；
         动态取色 system_accent1_* 由 Theme.java 反射采样（Android 12+ 生效）。 -->
    <style name="Theme.VUS" parent="android:Theme.DeviceDefault.Light">
        <item name="android:colorPrimary">#2962FF</item>
        <item name="android:colorPrimaryDark">#0D47A1</item>
        <item name="android:colorAccent">#2962FF</item>
        <item name="android:windowBackground">#F5F6FA</item>
        <item name="android:statusBarColor">#0D47A1</item>
    </style>
</resources>