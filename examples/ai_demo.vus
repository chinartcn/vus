# VUS AI 聚合模块调用示例
# ---------------------------------------------------------------------------
# 统一封装国内常用 AI 服务商的 OpenAI 兼容接口（rt/vus_ai.c，桌面回退 curl）：
#   对话 AI_请求 / 模型列表 AI_模型列表 / 文生图 AI_文生图 / 图生图 AI_图生图
#   后台工作流 AI_启动工作流 + 进度回调 AI_回调 / AI_清空回调 / AI_工作流状态
#
# 使用前：
#   1) 在 https://www.bigmodel.cn 获取智谱 API Key（cogview-3-flash 为永久免费文生图模型）
#   2) 把下面的 "sk-你的智谱APIKey" 替换为真实令牌
# 运行：vus run examples/ai_demo.vus

# ---- 1. 导入令牌池（"API_" 前缀自动剥除：导入后既可用 "API_glm" 也可用 "glm"） ----
AI_api池("{\"API_glm\":\"sk-你的智谱APIKey\"}")
打印("令牌池概览（脱敏）: " .. AI_api池() .. "\n")

# ---- 2. 对话调用：AI_请求(服务名, 模型[, 消息]) ----
回应 = AI_请求("glm", "glm-4-flash", "用一句话介绍 VUS 语言")
打印("对话回应: " .. 回应 .. "\n")

# ---- 3. 模型列表：AI_模型列表(服务名)（仅内置服务商支持） ----
模型 = AI_模型列表("glm")
打印("可用模型: " .. 模型 .. "\n")

# ---- 4. 文生图：AI_文生图(服务名, 模型, 提示词[, 尺寸]) ----
#     cogview-3-flash 为智谱官方免费模型（文档: docs.bigmodel.cn 的 free 目录）
图URL = AI_文生图("glm", "cogview-3-flash", "一只可爱的小橘猫，坐在阳光明媚的窗台上", "1024x1024")
打印("生成图片: " .. 图URL .. "\n")

# ---- 5. 图生图：AI_图生图(服务名, 模型, 图片路径, 提示词[, 强度]) ----
#     （cogview-3-flash 仅文生图；glm-image 系支持图生图，需要时取消注释）
# 图URL2 = AI_图生图("glm", "glm-image", "red.png", "把这只猫换成蓝眼睛", "0.6")
# 打印("图生图结果: " .. 图URL2 .. "\n")

# ---- 6. 后台工作流：启动 → 推进 → 回调进度 → 状态查询 ----
定义 AI_工作流_生成报告(参数):
    AI_返回("正在收集数据")
    AI_返回("正在生成报告")
    AI_返回("报告完成")
    AI_完成返回()

# 启动：同名槽重新启动会刷新状态与回调
AI_启动工作流("R", AI_工作流_生成报告, "季度")
打印("启动后状态: " .. AI_工作流状态("R") .. "\n")

# AI_回调 返回最近一次 AI_返回 的值（不管是否结束）；AI_推进 推进一步
AI_推进("R")
AI_推进("R")
打印("推进两次后回调: " .. AI_回调("R") .. "\n")

# 推到底：越过 AI_完成返回，状态变"完成"，回调仍保留最后结果
AI_推进("R")
打印("最终状态: " .. AI_工作流状态("R") .. " / 回调: " .. AI_回调("R") .. "\n")

# AI_回调_完成 判断是否已结束；AI_清空回调 复位回调值
打印("是否完成: " .. AI_回调_完成("R") .. "\n")
AI_清空回调("R")
打印("清空后回调: [" .. AI_回调("R") .. "]\n")

打印("示例完成\n")