#// VUS XYZ 体感音游 —— Solace (Feint & Laura Brehm) 专用脚本
#//
#// 谱面：examples/solace.chart.json（174 BPM 手铺，约 4 分 22 秒，574 音符）
#// 音频：把歌曲按节拍导出为 WAV，命名为 examples/solace.wav 与谱面对应。
#// 真机（Termux + termux-sensor + mpv，已启 Termux-X11）：
#//     ./vus run examples/solace_game.vus
#// 沙箱/无传感器/mpv 时静默降级（读数为 0、计时改用单调时钟），仅演示渲染与判定逻辑。

打印("VUS XYZ 体感音游 —— Solace：按谱面方向甩动手机！\n")

图形_初始化(420, 480, "VUS XYZ · Solace")
图形_外观(10)
图形_主题(0x0D1117, 0x2A3138, 0x35E0FF, 0xD6E4F0, 0x88A0B8)

# ============ 谱面加载 ============
谱面 = 文件_读取("examples/solace.chart.json")
如果 转数字(对象文本(JSON_查询(谱面, "note_count"))) <= 0:
    谱面 = 文件_读取("solace.chart.json")
标题 = 对象文本(JSON_查询(谱面, "title"))
时长 = 转数字(对象文本(JSON_查询(谱面, "duration_ms")))
note总数 = 转数字(对象文本(JSON_查询(谱面, "note_count")))
如果 note总数 <= 0:
    打印("错误：未找到可用谱面，请确认 examples/solace.chart.json 存在\n")
    返回
打印("谱面：" + 标题 + "  节拍数：" + note总数 + "\n")

# ============ 音频与计时 ============
音频_打开("examples/solace.wav")
音频_打开("solace.wav")
音频_播放()
# 沙箱无 mpv 时音频进度恒为 0，改用单调时钟演示计时
基准 = 转数字(时钟())

# ============ 判定参数（毫秒） ============
窗口 = 150

# ============ 全局状态 ============
阶段 = 0
i_cur = 0
分数 = 0
命中 = 0
错过 = 0
in_win = 0
flap = 0
爆光 = 0
当前 = 0
nt = 0
nd = 0
tg = 0
演示 = 0
进度 = 0
ax = 0
ay = 0
az = 0
轴值 = 0
整数进度 = 0
偏移 = 0
乘数 = 0
音符x = 0
标记色 = 0
提示 = ""
cx = 0
cy = 0
r = 0
爆色 = 0
光芒 = 0

当循环 阶段 == 0:
    图形_取事件()

    # ---- 计时：优先音频进度，否则单调时钟 ----
    演示 = 转数字(时钟()) - 基准
    进度 = 转数字(音频_进度())
    如果 进度 > 0:
        当前 = 进度
    否则:
        当前 = 演示

    # ---- 三轴读数（毫 g，取绝对值） ----
    ax = 转数字(传感器_读("x"))
    如果 ax < 0:
        ax = 0 - ax
    ay = 转数字(传感器_读("y"))
    如果 ay < 0:
        ay = 0 - ay
    az = 转数字(传感器_读("z"))
    如果 az < 0:
        az = 0 - az

    # ---- 音符判定 ----
    如果 i_cur < note总数:
        nt = 转数字(对象文本(JSON_查询(谱面, "notes[" + i_cur + "].t")))
        nd = 转数字(对象文本(JSON_查询(谱面, "notes[" + i_cur + "].d")))
        tg = 转数字(对象文本(JSON_查询(谱面, "notes[" + i_cur + "].target")))

        # 超过该音符判定窗口末端：记 MISS
        如果 当前 > nt + 窗口:
            错过 = 错过 + 1
            i_cur = i_cur + 1
            in_win = 0
            flap = 0
        # 进入窗口：判定当前方向轴甩动幅度
        否则如果 当前 >= nt - 窗口:
            如果 in_win == 0:
                in_win = 1
                flap = 0
            轴值 = 0
            如果 nd == 0:
                轴值 = az
            否则如果 nd == 1:
                轴值 = ax
            否则:
                轴值 = ay
            如果 轴值 > flap:
                flap = 轴值
            如果 flap > tg:
                分数 = 分数 + 1
                命中 = 命中 + 1
                爆光 = 12
                i_cur = i_cur + 1
                in_win = 0
                flap = 0

    如果 i_cur >= note总数:
        阶段 = 1

    # ---- 爆光衰减 ----
    如果 爆光 > 0:
        爆光 = 爆光 - 1

    # ================= 绘制 =================
    图形_填充(0, 0, 420, 480, 0x0D1117)

    # 标题与分数
    图形_文字(18, 16, "VUS XYZ · Solace", 0x35E0FF)
    图形_文字(18, 44, "分数: " + 分数 + " / " + note总数 + "   命中:" + 命中 + " 错失:" + 错过, 0xD6E4F0)

    # 谱面整体进度
    整数进度 = 0
    如果 时长 > 0:
        整数进度 = (当前 * 100) / 时长
    图形_进度("进度", 18, 72, 384, 12, 整数进度)

    # 击打判据条：音符从右向左逼近中央击打线
    图形_圆角填充(30, 108, 360, 26, 8, 0x1B222B)
    图形_填充(180, 108, 40, 26, 0x22313C)
    图形_填充(198, 108, 4, 26, 0x35E0FF)
    如果 i_cur < note总数:
        偏移 = nt - 当前
        如果 偏移 >= 0 - 窗口:
            如果 偏移 <= 窗口 * 2:
                乘数 = 120 * 偏移 / 窗口
                音符x = 200 + 乘数
                标记色 = 0x35E0FF
                如果 nd == 1:
                    标记色 = 0xFF7840
                如果 nd == 2:
                    标记色 = 0x40FF88
                图形_填充圆(音符x, 121, 9, 标记色)
                # 提示方向
                提示 = "甩向 Y!"
                如果 nd == 0:
                    提示 = "甩向 Z!"
                如果 nd == 1:
                    提示 = "甩向 X!"
                图形_文字(18, 142, "下一个：" + 提示 + "  (力度需 > " + tg + ")", 0x88A0B8)
            否则:
                图形_文字(18, 142, "预备…", 0x88A0B8)
        否则:
            图形_文字(18, 142, "预备…", 0x88A0B8)
    否则:
        图形_文字(18, 142, "结束", 0x88A0B8)

    # 中央十字准星（随垂直甩动撑大）
    cx = 210
    cy = 300
    r = 42 + az / 40
    图形_画线(cx - r, cy, cx + r, cy, 0x35E0FF)
    图形_画线(cx, cy - r, cx, cy + r, 0x35E0FF)
    图形_画圆(cx, cy, r, 0xE0E8F0)
    图形_画圆(cx, cy, r / 2, 0x88A0B8)

    # 命中发光
    如果 爆光 > 0:
        爆色 = 0x7DFF7D
        如果 爆光 > 5:
            爆色 = 0xF7FF7D
        光芒 = 14 + (12 - 爆光) * 6
        图形_填充圆(cx, cy, 光芒, 爆色)
        图形_填充圆(cx, cy, 光芒 * 2 / 3, 0xFFFFFF)

    # 底部三轴甩动能量条
    图形_文字(34, 436, "X", 0xFF7840)
    图形_进度("ex", 56, 434, 330, 16, ax / 28)
    图形_文字(34, 458, "Y", 0x40FF88)
    图形_进度("ey", 56, 456, 330, 16, ay / 28)
    图形_文字(34, 480, "Z", 0x35E0FF)
    图形_进度("ez", 56, 478, 330, 16, az / 28)

    图形_刷新()

# ================= 结算画面 =================
图形_取事件()
图形_填充(0, 0, 420, 480, 0x0D1117)
图形_文字(110, 180, "歌曲结束", 0xFFFFFF)
图形_文字(85, 220, "最终得分: " + 分数 + " / " + note总数, 0x35E0FF)
图形_文字(85, 250, "命中: " + 命中 + "   错失: " + 错过, 0xD6E4F0)
图形_刷新()
睡眠(2500)
打印("游戏结束：得分 " + 分数 + " / " + note总数 + "（命中 " + 命中 + "，错失 " + 错过 + "）\n")