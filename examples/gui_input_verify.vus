#// 阶段A：X11 多输入内建——映射与默认值验证（headless 无真实事件）
打印("多输入API验证开始\n")

r = 图形_初始化(200, 100, "输入验证")

# 无事件时的默认值
k1 = 图形_按键()
打印("图形_按键(空)=")
打印(k1)
打印("\n")

kc = 图形_按键码()
打印("图形_按键码(空)=")
打印(kc)
打印("\n")

mp = 图形_鼠标位置()
打印("图形_鼠标位置(空)=")
打印(mp)
打印("\n")

mx = 图形_鼠标x()
my = 图形_鼠标y()
打印("图形_鼠标x=")
打印(mx)
打印(" y=")
打印(my)
打印("\n")

wh = 图形_滚轮()
打印("图形_滚轮(空)=")
打印(wh)
打印("\n")

pd = 图形_键按下(1)
打印("图形_键按下(1)=")
打印(pd)
打印("\n")

# 悬停：注册一个按钮后测悬停（无鼠标移动应为 false）
r = 图形_按钮("测试钮", 10, 10, 80, 30, "钮")
hv = 图形_悬停("测试钮")
打印("图形_悬停(无移动)=")
打印(hv)
打印("\n")

图形_刷新()
打印("多输入API验证结束\n")