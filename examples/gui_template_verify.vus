#// 阶段B+C：主题模板 + 控件组合模板 验证（headless）
打印("主题与组合模板验证开始\n")

r = 图形_初始化(360, 260, "模板验证")

# 主题：深色主题
r = 图形_主题(0x222222, 0x555555, 0x4A9BFF, 0xDDDDDD, 0xFFFFFF)
打印("设置主题=")
打印(r)
打印("\n")

# 卡片（组合模板）
r = 图形_卡片("我的卡", 20, 20, 180, 120, "个人信息")
打印("卡片=")
打印(r)
打印("\n")

# 面板（卡片别名）
r = 图形_面板("右面板", 210, 20, 130, 100, "设置")
打印("面板=")
打印(r)
打印("\n")

# 表单行（组合模板）
r = 图形_表单行("姓名行", "姓名", 30, 60, 160, "")
打印("表单行=")
打印(r)
打印("\n")
r = 图形_表单行("邮箱行", "邮箱", 30, 90, 160, "a@x.com")
打印("表单行2=")
打印(r)
打印("\n")

# 圆环新控件
r = 图形_圆环("圆环1", 270, 70, 24, 70, -1)
打印("圆环=")
打印(r)
打印("\n")

# 控件绘制后用主题色的按钮验证（仅确认不崩溃）
r = 图形_按钮("确定钮", 30, 130, 80, 30, "确定")
打印("主题按钮=")
打印(r)
打印("\n")

图形_刷新()
打印("主题与组合模板验证结束\n")