#// =============================================================================
#// X11 实机手动点击测试：按钮控件 + 轮询交互 + 自然语言条件
#// =============================================================================
#//
#// 运行前置（Termux）：
#//   1. 启动 Termux-X11：termux-x11 :0 &
#//   2. export DISPLAY=:0
#//   3. ./vus run examples/guilite_click_demo.vus
#//
#// 预期：360x240 窗口出现两个按钮。
#//       - 点「开始」→ 背景变绿，窗口底部白字提示"开始已点击"
#//       - 点「退出」→ 背景变红，提示"退出已点击"
#//       点击事件通过以下自然语言方式判定：
#//           如果 按钮被点击("开始")
#//
#// 说明：轮询循环中调用 图形_取事件() 拉取 X 事件，睡眠 20ms 避免忙等。

打印("X11 点击演示开始\n")

# 初始化窗口
r = 图形_初始化(360, 240, "VUS 点击 Demo")
打印("初始化=")
打印(r)
打印("\n")

# 背景色（默认深灰）
背景 = 0x202020

# 绘制按钮：两个按钮
图形_按钮("开始", 40, 80, 120, 48, "开始")
图形_按钮("退出", 200, 80, 120, 48, "退出")

# 按钮下方提示文字
提示 = "点击上方按钮试试"

# 事件循环
计数 = 0
当循环 真:
    # 拉取 X 事件（非阻塞），处理点击
    图形_取事件()

    # 自然语言式点击判定
    如果 按钮被点击("开始"):
        # 点击开始：背景变绿，更新提示
        背景 = 0x205020
        提示 = "开始已点击！"

    如果 按钮被点击("退出"):
        背景 = 0x502020
        提示 = "退出已点击！"

    # 用背景填充整屏，再重绘按钮与文字（每次刷新画面）
    图形_填充(0, 0, 360, 240, 背景)
    图形_按钮("开始", 40, 80, 120, 48, "开始")
    图形_按钮("退出", 200, 80, 120, 48, "退出")
    图形_文字(120, 160, 提示, 0xFFFFFF)

    # 刷新到 X11 窗口
    图形_刷新()

    # 睡眠 20ms，避免轮询忙等挤占 CPU
    睡眠(20)

    # 计数保护：超过一定次数则停止演示（避免无限循环）
    计数 = 计数 + 1
    如果 计数 > 1000:
        跳出

图形_刷新()
打印("X11 点击演示结束\n")