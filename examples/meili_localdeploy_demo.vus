#// Meilisearch 本地部署全链路演示
#//
#// 用 VUS 内建函数 插件_运行 驱动两个插件：
#//   - Meilisearch本地部署拓展：部署 信息/安装/启动/集成
#//   - Meilisearch搜索：索引 创建 / 文档 添加 / 搜索
#// 全程用 日志_信息 输出各阶段进度，最后用 打印 输出搜索结果。
#//
#// 全链路：本地启动 Meilisearch → 建索引 → 加文档 → 搜索命中。

日志_信息("=== Meilisearch 本地部署全链路演示开始 ===")

#// 1. 查看部署方式（无 Docker 时回退官方二进制）
部署信息 = 插件_运行("Meilisearch本地部署拓展", "部署 信息")
日志_信息("[阶段1/7] 部署信息: ")
日志_信息(部署信息)

#// 2. 下载 Meilisearch v1.8.0 官方二进制（BinaryDeployer）
安装结果 = 插件_运行("Meilisearch本地部署拓展", "部署 安装 --版本 1.8.0")
日志_信息("[阶段2/7] 安装: ")
日志_信息(安装结果)

#// 3. 启动 default 实例（端口 7700，注入 master key）
启动结果 = 插件_运行("Meilisearch本地部署拓展", "部署 启动 --实例 default --端口 7700 --master-key vus-local-1.8.0-key --版本 1.8.0")
日志_信息("[阶段3/7] 启动: ")
日志_信息(启动结果)

#// 4. 集成：写 config.json 供搜索插件连接
集成结果 = 插件_运行("Meilisearch本地部署拓展", "部署 集成 --实例 default --端口 7700 --master-key vus-local-1.8.0-key")
日志_信息("[阶段4/7] 集成: ")
日志_信息(集成结果)

#// 5. 建索引 recipes（主键 id）
索引结果 = 插件_运行("Meilisearch搜索", "索引 创建 recipes --主键 id")
日志_信息("[阶段5/7] 建索引: ")
日志_信息(索引结果)

#// 6. 添加一条中文食谱文档（内联 JSON）
文档结果 = 插件_运行("Meilisearch搜索", "文档 添加 recipes --json \"[{\"id\":1,\"标题\":\"红烧肉\",\"食材\":\"五花肉\",\"评分\":5}]\"")
日志_信息("[阶段6/7] 加文档: ")
日志_信息(文档结果)

#// 7. 搜索概词「红烧肉」，验证命中
搜索结果 = 插件_运行("Meilisearch搜索", "搜索 红烧肉 --索引 recipes")
日志_信息("[阶段7/7] 搜索完成")

打印("=== 搜索结果 ===\n")
打印(搜索结果)
打印("\n=== 全链路演示完成 ===\n")