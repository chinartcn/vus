#// VUS 控件库完整应用示例 —— 含页面切换(tab)、全部控件、可点击交互
#//
#//   这个示例在一个 360x280 的窗口里做成"多页面应用"：
#//     · 顶部 主页/功能/关于 三个按钮切换页面
#//     · 每页都用到不同控件，点击全部可交互
#//     · 所有变量在选择循环体内使用前，已在顶部显式初始化(否则生成的 C 不声明变量)
#//
#// 运行(Termux 启动 X11 后)：
#//     cd ~/.vus
#//     ./vus run examples/gui_app_demo.vus
#// 窗口出现后点按钮/列表/复选框/画布，命中结果打印在运行终端里。

打印("控件库应用示例启动：点 主页/功能/关于 切换页面\n")

# ---- 窗口 ----
图形_初始化(360, 280, "VUS 控件库应用")

# ---- 变量先初始化(循环体内再赋值才安全) ----
当前页 = 1        # 1=主页 2=功能 3=关于
进度 = 40         # 主页进度条的百分比
记住 = 0          # 主页抽屉复选框
静音 = 0          # 功能页复选框
振动 = 0          # 功能页复选框
音量 = 60         # 功能页音量(+/-)，0..100
点 = "-1,-1"      # 画布命中相对坐标
计数 = 0

# ---- 主循环：每帧清屏重建当前页(tab 切换 = 改 当前页，下一帧画另一页) ----
当循环 计数 < 20000000:   # 长时间窗口；真机可改小；之后自动进入 图形_保持

    # 1) 取事件(消耗 X 点击：每点一次只触发一次)
    图形_取事件()

    # 2) 清屏背景
    图形_填充(0, 0, 360, 280, 0xF5F5F5)

    # 3) 顶部 tab 按钮(各页共用) + 跳页
    图形_按钮("tab主页", 20, 14, 72, 26, "主页")
    图形_按钮("tab功能", 100, 14, 72, 26, "功能")
    图形_按钮("tab关于", 180, 14, 72, 26, "关于")
    如果 图形_按钮点击("tab主页"):
        当前页 = 1
    如果 图形_按钮点击("tab功能"):
        当前页 = 2
    如果 图形_按钮点击("tab关于"):
        当前页 = 3

    # ================= 主页(仪表盘) =================
    如果 当前页 == 1:
        图形_标签("主页标题", 24, 58, "VUS 图形控件库", 0x12418C)
        图形_标签("主页副", 24, 78, "点下方控件体验交互", 0x777777)

        # 进度条 + 步进按钮
        图形_进度("主页进度", 24, 108, 180, 20, 进度)
        图形_按钮("步进", 214, 108, 82, 20, "进度 +20%")
        如果 图形_按钮点击("步进"):
            进度 = 进度 + 20
            如果 进度 >= 120:
                进度 = 10

        # 复选框
        图形_复选框("记住", 24, 142, "记住我", 记住)

        # 列表(点行可跳页)
        图形_列表("入口", 214, 140, 126, 120, 20)
        图形_列表行("入口", 0, "📖 仪表盘")
        图形_列表行("入口", 1, "⚙ 功能")
        图形_列表行("入口", 2, "ℹ 关于")
        如果 图形_列表行点击("入口", 0):
            当前页 = 1
        如果 图形_列表行点击("入口", 1):
            当前页 = 2
        如果 图形_列表行点击("入口", 2):
            当前页 = 3

        # 画布(点它取相对坐标)
        图形_画布("画板", 24, 180, 170, 84)
        循环 i 从 0 到 3:
            图形_画线(30 + i * 10, 250, 60 + i * 30, 190, 0xCCCCCC)
        循环 j 从 0 到 4:
            图形_画点(30 + j * 30, 250 - j * 15, 0xFF8800)
        如果 图形_画布命中("画板"):
            点 = 图形_画布点("画板")
            打印("[主页] 画板相对坐标 ")
            打印(点)
            打印("\n")

    # ================= 功能页(设置) =================
    如果 当前页 == 2:
        图形_标签("功能标题", 24, 58, "功能与偏好", 0x12418C)

        图形_复选框("静音", 24, 90, "静音", 静音)
        图形_复选框("振动", 24, 114, "振动反馈", 振动)

        # 音量：减/加 按钮 + 进度条显示
        图形_文本框("音量框", 24, 144, 130, 22, "音量调节")
        图形_按钮("音减", 164, 144, 40, 22, "-10")
        图形_按钮("音加", 208, 144, 40, 22, "+10")
        如果 图形_按钮点击("音减"):
            音量 = 音量 - 10
            如果 音量 < 0:
                音量 = 0
        如果 图形_按钮点击("音加"):
            音量 = 音量 + 10
            如果 音量 > 100:
                音量 = 100
        图形_进度("音量条", 24, 178, 150, 16, 音量)

        # 返回主页
        图形_按钮("回主页", 214, 170, 92, 26, "← 返回主页")
        如果 图形_按钮点击("回主页"):
            当前页 = 1

    # ================= 关于页 =================
    如果 当前页 == 3:
        图形_标签("关于标题", 24, 58, "关于", 0x12418C)
        图形_标签("关于行1", 24, 88, "VUS 编程语言 · GUI 控件库", 0x555555)
        图形_标签("关于行2", 24, 110, "本示例展示全部控件并可交互", 0x555555)
        图形_标签("关于行3", 24, 132, "主页/列表/复选框/进度/画布/文本框", 0x999999)
        图形_文本框("版本", 24, 162, 200, 22, "版本 0.1.0 · GuiLite 渲染")
        图形_按钮("回主页2", 24, 200, 100, 26, "← 返回主页")
        如果 图形_按钮点击("回主页2"):
            当前页 = 1

    # 4) 刷新一帧
    图形_刷新()
    计数 = 计数 + 1

图形_保持()
打印("演示结束\n")