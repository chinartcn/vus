#// =============================================================================
#// VUS 终端文本编辑器 —— 帧缓冲画布 + 差分刷新 示例
#// =============================================================================
#//
#// 演示 VUS 终端 UI 画布子系统（rt/vus_tui.c）：
#//   - tui_画布 / tui_清画布 / tui_绘制文本 / tui_刷新（差分上屏）
#//   - tui_终端尺寸 / tui_定位 / tui_光标
#//   - tui_读取按键（非阻塞读键，含方向键 ESC 组合序列）
#//   - 文件_读取 / 文件_写入（Ctrl-S 保存）
#//
#// 运行：
#//   ./vus run examples/tui_editor.vus
#//
#// 按键：
#//   ↑ ↓ ← →      移动光标
#//   Ctrl-A / Ctrl-E  行首 / 行尾
#//   回车          拆行
#//   退格          删除
#//   Ctrl-S        保存到 editor_demo.txt
#//   Ctrl-Q        退出
#//
#// 说明：光标按字节移动。ASCII 文本体验与常规编辑器一致；
#//       中文按 UTF-8 字节处理（显示正确，移动/删除按字节，
#//       每字 3 字节）。非交互终端（管道/CI）300 次空读后
#//       自动退出，便于自动化验证。
#// =============================================================================

# ---- 全局状态 ----
路径 = "editor_demo.txt"
内容 = ""
光标行 = 0        # 0 基
光标列 = 0        # 0 基字节下标
顶行 = 0          # 垂直滚动偏移
运行中 = "1"
空键数 = 0
提示 = "就绪"
终端行数 = 24
终端列数 = 80

# =============================================================================
# 文档模型：内容为按 \n 分隔的字符串；列表操作不可变，编辑后重拼全文
# =============================================================================

# 当前光标所在行
定义 当前行():
    行们 = 文本_行(内容)
    返回 列表_取(行们, 光标行)

# 总行数
定义 取行数():
    行们 = 文本_行(内容)
    返回 列表_长度(行们)

# 用 新行 替换第 行号 行（重拼 内容，保持其余行与换行符不变）
定义 换行(行号, 新行):
    全局 内容
    行们 = 文本_行(内容)
    上限 = 列表_长度(行们) - 1
    结果 = ""
    循环 i 从 0 到 上限:
        t = 列表_取(行们, i)
        如果 i == 行号:
            t = 新行
        如果 i == 0:
            结果 = t
        否则:
            结果 = 结果 .. "\n" .. t
    内容 = 结果

# 删除第 行号 行
定义 删除行(行号):
    全局 内容
    行们 = 文本_行(内容)
    上限 = 列表_长度(行们) - 1
    结果 = ""
    首次 = "1"
    循环 i 从 0 到 上限:
        如果 i == 行号:
            继续
        t = 列表_取(行们, i)
        如果 首次 == "1":
            结果 = t
            首次 = "0"
        否则:
            结果 = 结果 .. "\n" .. t
    内容 = 结果

# 光标列钳制到当前行长度
定义 钳列():
    全局 光标列
    行 = 当前行()
    如果 光标列 > 长度(行):
        光标列 = 长度(行)

# 垂直滚动：保证光标可见
定义 滚动():
    全局 顶行
    可视 = 终端行数 - 2
    如果 光标行 < 顶行:
        顶行 = 光标行
    如果 光标行 >= 顶行 + 可视:
        顶行 = 光标行 - 可视 + 1

# =============================================================================
# 编辑操作
# =============================================================================

定义 插入(键):
    全局 光标列
    全局 提示
    行 = 当前行()
    前 = 文本_子串(行, 0, 光标列)
    后 = 文本_子串(行, 光标列, 长度(行) - 光标列)
    换行(光标行, 前 .. 键 .. 后)
    光标列 = 光标列 + 长度(键)
    提示 = "插入"

定义 回车():
    全局 光标行
    全局 光标列
    全局 提示
    行 = 当前行()
    前 = 文本_子串(行, 0, 光标列)
    后 = 文本_子串(行, 光标列, 长度(行) - 光标列)
    换行(光标行, 前 .. "\n" .. 后)
    光标行 = 光标行 + 1
    光标列 = 0
    滚动()
    提示 = "拆行"

定义 退格():
    全局 光标行
    全局 光标列
    全局 提示
    行 = 当前行()
    如果 光标列 > 0:
        前 = 文本_子串(行, 0, 光标列 - 1)
        后 = 文本_子串(行, 光标列, 长度(行) - 光标列)
        换行(光标行, 前 .. 后)
        光标列 = 光标列 - 1
        提示 = "删除"
        返回
    # 光标在行首：与上一行合并
    如果 光标行 > 0:
        行们 = 文本_行(内容)
        上行 = 列表_取(行们, 光标行 - 1)
        当前 = 行
        删除行(光标行)
        换行(光标行 - 1, 上行 .. 当前)
        光标行 = 光标行 - 1
        光标列 = 长度(上行)
        滚动()
        提示 = "合并行"

定义 保存():
    全局 提示
    结果 = 文件_写入(路径, 内容)
    如果 结果 == "0":
        提示 = "已保存 " .. 路径
    否则:
        提示 = "保存失败!"

# =============================================================================
# 渲染：整帧重绘画布 → 差分上屏（只有变化的单元格才输出到终端）
# =============================================================================

定义 渲染():
    tui_清画布()
    行们 = 文本_行(内容)
    总数 = 列表_长度(行们)
    可视 = 终端行数 - 2
    上限 = 可视 - 1
    循环 r 从 0 到 上限:
        sr = 顶行 + r
        如果 sr < 总数:
            行 = 列表_取(行们, sr)
            编号 = sr + 1
            # 行号栏（6 列，灰）
            槽 = 文本_子串(编号 .. "      ", 0, 6)
            tui_绘制文本(r + 1, 1, 槽, 241, -1, 0)
            # 正文（截断到画布宽，中文整段显示正确）
            余宽 = 终端列数 - 7
            显示 = 文本_子串(行, 0, 余宽)
            tui_绘制文本(r + 1, 7, 显示, -1, -1, 0)
        否则:
            tui_绘制文本(r + 1, 1, "~     ", 241, -1, 0)
    # 状态栏（蓝底白字）
    状态 = 路径 .. "  行 " .. (光标行 + 1) .. "/" .. 总数 .. "  列 " .. (光标列 + 1) .. "  " .. 提示
    状态 = 文本_子串(状态, 0, 终端列数)
    tui_绘制文本(终端行数 - 1, 1, 状态, 7, 4, 0)
    # 帮助栏（灰底深字）
    帮助 = "Ctrl-S 保存 | Ctrl-Q 退出 | 方向键移动 | 回车拆行 | 退格删除"
    帮助 = 文本_子串(帮助, 0, 终端列数)
    tui_绘制文本(终端行数, 1, 帮助, 8, 7, 0)
    tui_刷新()
    # 把终端光标放到编辑位置（画布上是坐标，终端用 tui_定位）
    可视行 = 光标行 - 顶行 + 1
    可视列 = 光标列 + 7
    如果 可视行 >= 1 和 可视行 <= 可视:
        tui_定位(可视行, 可视列)
    tui_光标(1)

# =============================================================================
# 初始化
# =============================================================================

# 查询终端尺寸（无终端回退 24,80），并限制在画布上限内
尺寸 = tui_终端尺寸()
尺寸们 = 文本_分割(尺寸, ",")
终端行数 = 列表_取(尺寸们, 0)
终端列数 = 列表_取(尺寸们, 1)
如果 转数字(终端行数) > 128:
    终端行数 = "128"
如果 转数字(终端列数) > 256:
    终端列数 = "256"
tui_画布(终端行数, 终端列数)

# 载入文件；不存在则生成示例文本
如果 文件_存在(路径):
    内容 = 文件_读取(路径)
否则:
    内容 = "欢迎使用 VUS 终端文本编辑器！\n这是一个用 VUS 语言编写的 TUI 示例。\n\n它基于「帧缓冲画布 + 差分刷新」模型：\n每次按键后整帧重绘画布，tui_刷新 只把\n变化的部分输出到终端，复杂界面也不闪烁。\n\n快捷键：\n  Ctrl-S  保存到 editor_demo.txt\n  Ctrl-Q  退出\n  方向键  移动光标（中文按 UTF-8 字节移动）\n  回车    拆行\n  退格    删除\n\n试试把下面这行改成你自己的话：\nVUS —— 中文直译 C 的脚本语言。\n"

tui_清屏()
tui_刷新()

# =============================================================================
# 主循环：渲染 → 读键 → 处理
# =============================================================================

当循环 运行中 == "1":
    渲染()
    键 = tui_读取按键()

    # 非交互终端（管道/CI）：300 次空读后自动退出
    如果 键 == "":
        空键数 = 空键数 + 1
        如果 空键数 > 300:
            打印("（终端无输入，编辑器演示结束）\n")
            跳出
        睡眠(10)
        继续
    空键数 = 0

    # 方向键（ESC 组合序列）
    如果 键 == "\x1b[A":
        如果 光标行 > 0:
            光标行 = 光标行 - 1
            钳列()
            滚动()
        继续
    如果 键 == "\x1b[B":
        总数 = 取行数()
        如果 光标行 < 总数 - 1:
            光标行 = 光标行 + 1
            钳列()
            滚动()
        继续
    如果 键 == "\x1b[C":
        行 = 当前行()
        如果 光标列 < 长度(行):
            光标列 = 光标列 + 1
        继续
    如果 键 == "\x1b[D":
        如果 光标列 > 0:
            光标列 = 光标列 - 1
        继续

    # 行首 / 行尾
    如果 键 == "\x01":
        光标列 = 0
        继续
    如果 键 == "\x05":
        行 = 当前行()
        光标列 = 长度(行)
        继续

    # 回车拆行
    如果 键 == "\r" 或 键 == "\n":
        回车()
        继续

    # 退格删除
    如果 键 == "\x7f" 或 键 == "\x08":
        退格()
        继续

    # 保存
    如果 键 == "\x13":
        保存()
        继续

    # 退出（Ctrl-Q / Ctrl-C / 单独 ESC）
    如果 键 == "\x11" 或 键 == "\x03" 或 键 == "\x1b":
        运行中 = "0"
        跳出

    # 其余可打印字节（含中文等多字节 UTF-8）→ 插入
    插入(键)

# =============================================================================
# 退出：清屏恢复终端
# =============================================================================

tui_清屏()
tui_刷新()
打印("编辑器已退出，文件: ")
打印(路径)
打印("\n")
