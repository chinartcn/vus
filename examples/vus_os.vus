#// =============================================================================
#// VUS-OS —— 一个用 VUS 语言编写的最小桌面操作系统演示
#// =============================================================================
#//
#// 组成：
#//   1. 加载动画：启动圆环 + 进度条，完成后自动进入桌面
#//   2. 窗口管理器：基于 VUS 页面栈（图形_页面_打开/返回）实现多窗口切换
#//   3. 文件管理器：文件夹导航（进入目录 / 返回上级 / 回主目录）
#//      依赖运行时扩展：文件_列表 / 文件_是目录 / 文本_分割
#//   4. 终端：真实 shell —— 键盘输入命令，回车执行
#//      依赖运行时扩展：命令_执行（popen 捕获输出）
#//
#// 屏幕说明：内置 8x8 位图字体仅含 ASCII，界面文字使用英文；
#//           窗口标题可为中文（X11 层支持）。
#//
#// 运行：
#//   ./vus run examples/vus_os.vus
#// =============================================================================

# ---- 全局状态 ----
宽 = 480
高 = 340
目录 = "/"          # 文件管理器当前目录
上级 = ""          # 文件管理器当前目录的父目录（用于"上一级"）
终端_文本 = ""     # 终端历史输出（含已执行命令与结果）
终端_行 = ""       # 终端当前输入行
终端_提示 = "$ "

# =============================================================================
# 页：加载动画
# =============================================================================
定义 页_加载():
    图形_填充(0, 0, 宽, 高, 0x0b0e17)
    图形_文字(196, 108, "VUS-OS", 0x4da3ff)
    图形_文字(150, 128, "Loading system...", 0x888a99)
    p = 0
    当循环 p <= 100:
        图形_填充(0, 0, 宽, 高, 0x0b0e17)
        图形_文字(196, 108, "VUS-OS", 0x4da3ff)
        图形_文字(122, 128, "Loading system...", 0x888a99)
        # 启动圆环（按帧扫一段弧）
        图形_圆环("boot", 240, 196, 40, p, 0x4da3ff)
        # 进度条
        图形_填充(80, 258, 宽 - 160, 10, 0x1a1f2e)
        图形_填充(80, 258, (宽 - 160) * p / 100, 10, 0x4da3ff)
        图形_文字(214, 272, p .. "%", 0xdddddd)
        图形_刷新()
        睡眠(24)
        p = p + 3
    # 启动完成，进入桌面
    图形_页面_打开("桌面")

# =============================================================================
# 页：桌面（窗口管理器主页）
# =============================================================================
定义 页_桌面():
    图形_填充(0, 0, 宽, 高, 0x0b0e17)
    # 顶部状态栏
    图形_填充(0, 0, 宽, 26, 0x12151f)
    图形_文字(8, 7, "VUS-OS Desktop", 0x4da3ff)
    时钟 = 日期_时() .. ":" .. 日期_分()
    图形_文字(宽 - 52, 7, 时钟, 0xaaaaaa)
    # 应用图标（窗口管理器以页面栈承载各"窗口"）
    图形_按钮("app_files", 28, 70, 96, 62, "Files")
    图形_按钮("app_term", 148, 70, 96, 62, "Terminal")
    图形_按钮("app_about", 268, 70, 96, 62, "About")
    图形_文字(40, 140, "File Manager", 0x8899aa)
    图形_文字(160, 140, "Terminal", 0x8899aa)
    图形_文字(280, 140, "About", 0x8899aa)
    图形_按钮("app_power", 宽 - 112, 高 - 40, 96, 26, "Power Off")
    # 交互
    如果 图形_按钮点击("app_files"):
        图形_页面_打开("文件")
    否则如果 图形_按钮点击("app_term"):
        图形_页面_打开("终端")
    否则如果 图形_按钮点击("app_about"):
        图形_页面_打开("关于")
    否则如果 图形_按钮点击("app_power"):
        图形_页面_打开("关于")

# =============================================================================
# 页：文件管理器
# =============================================================================
定义 页_文件():
    全局 目录
    全局 上级
    图形_填充(0, 0, 宽, 高, 0x0f1218)
    # 标题与地址栏
    图形_文字(8, 6, "File Manager", 0x4da3ff)
    图形_文字(8, 20, "Dir: " .. 目录, 0xdddddd)
    # 工具栏
    图形_按钮("fm_home", 8, 34, 70, 22, "Home")
    图形_按钮("fm_up", 84, 34, 70, 22, "Up")
    图形_按钮("fm_back", 158, 34, 96, 22, "Desktop")
    如果 图形_按钮点击("fm_home"):
        目录 = "/"
        上级 = ""
    否则如果 图形_按钮点击("fm_up"):
        如果 上级 != "":
            目录 = 上级
            上级 = ""
    否则如果 图形_按钮点击("fm_back"):
        图形_页面_打开("桌面")
    # 目录内容列表（逐行渲染；文本_分割 直接返回列表，P7）
    图形_列表("files", 8, 64, 宽 - 16, 高 - 112, 16)
    列表 = 文本_分割(文件_列表(目录), "\n")
    i = 0
    循环 元素 在 列表:
        如果 元素 != "":
            图形_列表行("files", i, 元素)
            如果 图形_列表行点击("files", i):
                候选 = 目录 .. "/" .. 元素
                如果 文件_是目录(候选) == "true":
                    上级 = 目录
                    目录 = 候选
            i = i + 1
    图形_文字(8, 高 - 18, "Click a folder to enter; files show in list", 0x556066)

# =============================================================================
# 页：终端（真实 shell）
# =============================================================================
定义 页_终端():
    全局 终端_文本
    全局 终端_行
    图形_填充(0, 0, 宽, 高, 0x0a0d12)
    图形_文字(8, 6, "Terminal", 0x4da3ff)
    图形_按钮("term_clear", 宽 - 204, 4, 96, 20, "Clear")
    图形_按钮("term_back", 宽 - 104, 4, 96, 20, "Desktop")
    如果 图形_按钮点击("term_clear"):
        终端_文本 = ""
    否则如果 图形_按钮点击("term_back"):
        图形_页面_打开("桌面")
    # 历史输出 + 当前输入行（Markdown 多行渲染）
    体 = 终端_文本 .. 终端_提示 .. 终端_行
    r = 图形_MD(8, 34, 宽 - 16, 体)
    图形_文字(8, 高 - 16, "Type a command and press Enter to run", 0x445055)

# =============================================================================
# 页：关于
# =============================================================================
定义 页_关于():
    图形_填充(0, 0, 宽, 高, 0x0f1218)
    图形_文字(170, 50, "VUS-OS", 0x4da3ff)
    图形_文字(96, 76, "A tiny desktop OS written in VUS", 0xccd0da)
    图形_文字(96, 96, "Window manager: page stack", 0x8899aa)
    图形_文字(96, 112, "Apps: Files / Terminal / About", 0x8899aa)
    图形_文字(96, 132, "Shell: builtin 命令_执行 (popen)", 0x8899aa)
    图形_按钮("about_back", 186, 170, 108, 28, "Back")
    如果 图形_按钮点击("about_back"):
        图形_页面_打开("桌面")

# =============================================================================
# 事件回调：键盘输入（仅终端页有效）
#   ch   = 可打印字符（Enter/方向键等不可打印时为空串）
#   键码 = X11 KeySym 数值字符串（Enter=65293 / 小键盘回车=65421）
# =============================================================================
定义 事件_按键(ch, 键码):
    全局 终端_文本
    全局 终端_行
    如果 图形_页面_当前() == "终端":
        如果 ch != "":
            终端_行 = 终端_行 .. ch
        否则:
            如果 键码 == "65293" 或 键码 == "65421":
                命令 = 终端_行
                终端_文本 = 终端_文本 .. 终端_提示 .. 命令 .. "\n"
                如果 命令 != "":
                    输出 = 命令_执行(命令)
                    终端_文本 = 终端_文本 .. 输出 .. "\n"
                否则:
                    终端_文本 = 终端_文本 .. "\n"
                终端_行 = ""

# =============================================================================
# 启动：初始化 → 加载动画 → 桌面主循环
# =============================================================================
r = 图形_初始化(宽, 高, "VUS-OS 桌面系统")
图形_页面_打开("加载")
当循环 真:
    图形_取事件()
    图形_页面_绘制()
    图形_刷新()
    睡眠(90)