# Cordis 式上下文元框架示例（路线 B：VUS 语言层）
# 运行：vus run examples/cordis/example.vus
#
# 说明：
#   注册服务 = 声明一个可注入"插件"（依赖驱动 DAG 拓扑激活）
#   服务获取 = 取已激活服务的 impl（数据）
#   监听事件/发射事件/管线事件 = 事件四模式分发
#   挂载效果 = 可逆副作用（进程退出逆序回退）

定义 应用_初始化(_impl):
    打印("应用服务已激活")
定义 应用_拆卸(_impl):
    打印("应用服务已拆卸")

# 注册服务：应用 依赖 日志 —— 即使 应用 先注册，也是 日志 先激活
注册服务 ("日志", {数据: "v3.0 日志模块"})
注册服务 ("应用", {依赖: ["日志"], 初始化: 应用_初始化, 拆卸: 应用_拆卸, 数据: "主应用"})

打印("日志服务 = " .. 服务获取 ("日志"))
打印("应用服务 = " .. 服务获取 ("应用"))

# 事件：EMIT 广播（按注册顺序），观察者收到事件参数
定义 上报甲(_参数):
    打印("上报甲 收到: " .. _参数)
定义 上报乙(_参数):
    打印("上报乙 收到: " .. _参数)
监听事件 ("启动完成", 上报甲, "观察")
监听事件 ("启动完成", 上报乙, "观察")
发射事件 ("启动完成", "hello")

# WATERFALL 管线：按注册顺序依次经过每个中间件
定义 鉴权(_参数):
    打印("鉴权通过")
定义 业务(_参数):
    打印("执行业务")
监听事件 ("请求", 鉴权, "中间件")
监听事件 ("请求", 业务, "中间件")
管线事件 ("请求", "req-1", "中间件")

# effect：进程退出时逆序回退（后注册先撤销）
定义 关闭句柄(_h):
    打印("关闭句柄: " .. _h)
挂载效果 (关闭句柄, "数据库连接")
挂载效果 (关闭句柄, "缓存池")