{
  "type": "界面",
  "标题": "布局模板冒烟",
  "子组件": [
    {
      "type": "侧边栏布局",
      "宽度": 220,
      "菜单": [
        { "type": "按钮", "文字": "概览", "事件": { "事件名": "切页", "回调变量": ["1"] } },
        { "type": "按钮", "文字": "文档", "事件": { "事件名": "切页", "回调变量": ["2"] } }
      ],
      "内容": [ { "type": "文本", "内容": "主区内容" } ]
    },
    {
      "type": "侧边栏布局",
      "内容": [ { "type": "文本", "内容": "默认宽度" } ]
    },
    {
      "type": "顶栏布局",
      "标题": "文档中心",
      "动作": [
        { "type": "按钮", "文字": "搜索", "事件": { "事件名": "打开搜索" } },
        { "type": "按钮", "文字": "设置", "事件": { "事件名": "打开设置" } }
      ],
      "内容": [ { "type": "文本", "内容": "正文区" } ]
    },
    {
      "type": "宫格导航",
      "行们": [
        {
          "type": "行",
          "子组件": [
            { "type": "卡片", "宽度": 96, "高度": 96, "子组件": [ { "type": "文本", "内容": "首页" } ] },
            { "type": "卡片", "宽度": 96, "高度": 96, "子组件": [ { "type": "文本", "内容": "文档" } ] },
            { "type": "卡片", "宽度": 96, "高度": 96, "子组件": [ { "type": "文本", "内容": "设置" } ] }
          ]
        }
      ]
    },
    {
      "type": "分组列表",
      "分组": [
        { "节标题": "基础", "标题": "快速上手", "副标题": "五分钟" },
        { "节标题": "进阶", "标题": "网络与文件", "副标题": "第 2 章" }
      ]
    }
  ]
}