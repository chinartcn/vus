{
  "中文名": "搜索条",
  "英文名": "searchbar",
  "模板": {
    "type": "行",
    "子组件": [
      {
        "type": "输入框",
        "id": "{id}_关键词",
        "variable": "{variable}",
        "标签": "搜索",
        "提示": "{提示}"
      },
      {
        "type": "按钮",
        "id": "{id}_搜索",
        "文字": "{按钮文字}",
        "事件": {
          "事件名": "执行搜索",
          "回调变量": ["{variable}"]
        }
      }
    ]
  }
}