{
  "中文名": "侧边栏布局",
  "英文名": "sidebar",
  "默认": {
    "宽度": 180,
    "菜单样式": "menu",
    "菜单": [],
    "内容": []
  },
  "模板": {
    "type": "行",
    "子组件": [
      {
        "type": "列",
        "宽度": "{宽度}",
        "样式": "{菜单样式}",
        "子组件": [ "{菜单}" ]
      },
      {
        "type": "卡片",
        "权重": 1,
        "子组件": [ "{内容}" ]
      }
    ]
  }
}