{
  "中文名": "顶栏布局",
  "英文名": "topbar",
  "默认": {
    "标题": "",
    "返回文字": "‹ 返回",
    "动作": [],
    "内容": []
  },
  "模板": {
    "type": "列",
    "子组件": [
      {
        "type": "行",
        "子组件": [
          { "type": "按钮", "文字": "{返回文字}", "事件": { "事件名": "返回页面" } },
          { "type": "文本", "内容": "{标题}", "样式": "title" },
          { "type": "行", "子组件": [ "{动作}" ] }
        ]
      },
      { "type": "卡片", "权重": 1, "子组件": [ "{内容}" ] }
    ]
  }
}