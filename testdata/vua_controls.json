{
  "版本": 1,
  "控件表": {
    "界面": {
      "描述": "页面根容器（竖布局卡片）；每 .vui 文件一个，含 标题/子组件",
      "字段": {
        "标题":   { "类型": "字符串" },
        "子组件": { "类型": "数组" },
        "宽度":   { "类型": "整数" },
        "高度":   { "类型": "整数" },
        "权重":   { "类型": "整数" }
      }
    },
    "列": {
      "描述": "竖布局容器（可套卡片背景）；横向排列请用「行」",
      "字段": {
        "标题": { "类型": "字符串" },
        "宽度": { "类型": "整数" },
        "高度": { "类型": "整数" },
        "权重": { "类型": "整数" }
      }
    },
    "行": {
      "描述": "横布局容器（不套卡片背景）",
      "字段": {
        "宽度": { "类型": "整数" },
        "高度": { "类型": "整数" },
        "权重": { "类型": "整数" }
      }
    },
    "卡片": {
      "描述": "卡片容器（竖布局 + 大圆角 + 阴影层级）",
      "字段": {
        "标题": { "类型": "字符串" },
        "宽度": { "类型": "整数" },
        "高度": { "类型": "整数" },
        "权重": { "类型": "整数" }
      }
    },
    "文本": {
      "描述": "静态文本，可有变量占位符（内容=变量名时注入值）",
      "字段": {
        "内容": { "类型": "字符串" },
        "样式": { "类型": "字符串", "默认值": "body" }
      }
    },
    "按钮": {
      "描述": "触发事件按钮；事件名=检查更新时走 Java 侧检查",
      "字段": {
        "文字": { "类型": "字符串", "默认值": "确定" },
        "样式": { "类型": "字符串" }
      }
    },
    "输入框": {
      "描述": "单行/多行文本输入（type=tarea 为多行）",
      "字段": {
        "标签": { "类型": "字符串" },
        "提示": { "类型": "字符串" }
      }
    },
    "复选框": {
      "描述": "勾选框（MD3 主色着色）",
      "字段": {
        "标签": { "类型": "字符串" }
      }
    },
    "开关": {
      "描述": "开关（MD3 thumb=主色）",
      "字段": {
        "标签": { "类型": "字符串" }
      }
    },
    "滑块": {
      "描述": "水平滑块（SeekBar，MD3 主色）",
      "字段": {
        "值":   { "类型": "整数", "默认值": 50 },
        "标签": { "类型": "字符串" },
        "最小值": { "类型": "整数", "默认值": 0 },
        "最大值": { "类型": "整数", "默认值": 100 }
      }
    },
    "进度条": {
      "描述": "水平进度条（progressBarStyleHorizontal），百分比=1 时右侧显示百分比文本",
      "字段": {
        "最大值": { "类型": "整数", "默认值": 100 },
        "值":   { "类型": "整数", "默认值": 0 },
        "百分比": { "类型": "整数", "默认值": 0 },
        "标签": { "类型": "字符串" },
        "颜色": { "类型": "颜色" }
      }
    },
    "分隔线": {
      "描述": "水平分隔线（颜色/粗细/上下外边距）",
      "字段": {
        "粗细": { "类型": "整数", "默认值": 1 },
        "颜色": { "类型": "颜色" },
        "上边距": { "类型": "整数", "默认值": 0 },
        "下边距": { "类型": "整数", "默认值": 0 }
      }
    },
    "间距": {
      "描述": "不可见空白占位（宽/高 dp，0=自动收缩）",
      "字段": {
        "宽": { "类型": "整数", "默认值": 0 },
        "高": { "类型": "整数", "默认值": 0 }
      }
    },
    "下拉": {
      "描述": "下拉选择（Spinner，选项数组；值与 saved 变量联动）",
      "字段": {
        "标签": { "类型": "字符串" },
        "选项": { "类型": "数组" }
      }
    },
    "图标": {
      "描述": "图标/表情占位（名称等于 Android 图标标识时用真实图标）",
      "字段": {
        "名称": { "类型": "字符串" },
        "src":  { "类型": "字符串" },
        "宽":   { "类型": "整数" },
        "高":   { "类型": "整数" },
        "标签": { "类型": "字符串" }
      }
    },
    "图片": {
      "描述": "图片（网络图异步加载；失败显示占位文本）",
      "字段": {
        "src":   { "类型": "字符串" },
        "地址":  { "类型": "字符串" },
        "标签":  { "类型": "字符串" },
        "宽":    { "类型": "整数" },
        "高":    { "类型": "整数" },
        "权重":  { "类型": "整数" }
      }
    },
    "列表": {
      "描述": "ListView 虚拟化列表（分组头 + convertView 复用 + 滚底加载更多）",
      "字段": {
        "数据":   { "类型": "数组" },
        "加载更多": { "类型": "字符串" },
        "事件":   { "类型": "字符串" },
        "高度":   { "类型": "整数", "默认值": 480 }
      }
    },
    "网页": {
      "描述": "网页/富文本：url 直载；html 原样渲染；内容按 Markdown 转 HTML",
      "字段": {
        "url":   { "类型": "字符串" },
        "html":  { "类型": "字符串" },
        "内容":  { "类型": "字符串" },
        "高度":  { "类型": "整数", "默认值": 480 }
      }
    },
    "音乐播放器": {
      "描述": "内嵌音乐播放器控件（复用 VusMedia 音频单例；播放/暂停/进度/音量）",
      "字段": {
        "源":     { "类型": "字符串" },
        "循环":   { "类型": "布尔", "默认值": false },
        "音量":   { "类型": "小数", "默认值": 1 },
        "高度":   { "类型": "整数", "默认值": 56 },
        "圆角":   { "类型": "整数", "默认值": 12 },
        "背景色": { "类型": "颜色" },
        "主色":   { "类型": "颜色" },
        "src":    { "类型": "字符串" },
        "loop":   { "类型": "布尔", "默认值": false },
        "volume": { "类型": "小数", "默认值": 1 },
        "height": { "类型": "整数", "默认值": 56 },
        "radius": { "类型": "整数", "默认值": 12 },
        "corner": { "类型": "整数", "默认值": 12 },
        "bg":     { "类型": "颜色" },
        "background": { "类型": "颜色" },
        "accent": { "类型": "颜色" }
      }
    },
    "视频播放器": {
      "描述": "页内 VideoView + 控制条视频播放器（全屏切换走 MediaActivity）",
      "字段": {
        "源":       { "类型": "字符串" },
        "自动播放": { "类型": "布尔", "默认值": false },
        "高度":     { "类型": "整数", "默认值": 240 },
        "圆角":     { "类型": "整数", "默认值": 12 },
        "背景色":   { "类型": "颜色" },
        "主色":     { "类型": "颜色" },
        "src":      { "类型": "字符串" },
        "autoplay": { "类型": "布尔", "默认值": false },
        "height":   { "类型": "整数", "默认值": 240 },
        "radius":   { "类型": "整数", "默认值": 12 },
        "corner":   { "类型": "整数", "默认值": 12 },
        "bg":       { "类型": "颜色" },
        "background": { "类型": "颜色" },
        "accent":   { "类型": "颜色" }
      }
    },
    "课表": {
      "描述": "课表表格（TableLayout，星期×节次×课程 三维数组）",
      "字段": {
        "标题":   { "类型": "字符串", "默认值": "课程表" },
        "星期":   { "类型": "数组" },
        "节次":   { "类型": "数组" },
        "课程":   { "类型": "数组" },
        "背景色": { "类型": "颜色" }
      }
    },
    "侧边栏": {
      "描述": "抽屉侧边栏（菜单 + 内容区 + 事件，可切侧）",
      "字段": {
        "菜单":  { "类型": "数组" },
        "内容":  { "类型": "数组" },
        "事件":  { "类型": "对象" },
        "宽度":  { "类型": "整数", "默认值": 240 },
        "侧":    { "类型": "字符串", "默认值": "左" }
      }
    }
  }
}