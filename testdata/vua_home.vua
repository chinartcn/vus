      "事件": { "事件名": "打开逻辑", "回调变量": [] } },
    { "type": "按钮", "id": "btn1", "文字": "打开设置",
      "事件": { "事件名": "打开设置", "回调变量": [] } },
    { "type": "按钮", "id": "btn_class", "文字": "课表(测试能力)",
      "事件": { "事件名": "打开课表", "回调变量": [] } },
    { "type": "按钮", "id": "btn_update", "文字": "检查更新",
      "事件": { "事件名": "检查更新" } },
    { "type": "输入框", "id": "in1", "variable": "备注", "标签": "备注", "提示": "输入备注" },
    { "type": "文本", "内容": "以下为 .vaz 示例：搜索条(自定义复合控件，构建期展开)" },
    { "type": "搜索条", "id": "sb1", "variable": "关键词", "提示": "输入要搜索的内容", "按钮文字": "搜一搜" },
    { "type": "文本", "内容": "星级评分(点击 ★ 调整，构建期展开)" },
    { "type": "星级评分", "id": "rate1", "变量": "星级" }
