// vua_test.vus — VUA Android 组件流 冒烟逻辑
// 多屏导航：主页 → 逻辑测试页 / 设置页 → 返回主页。
// 逻辑页用 界面_设置 / 界面_取 维护状态，渲染树变量回填实时显示。
// 顶部导入 .vaz 依赖包 "通用控件包" 的逻辑库（构建期由编译器内建展开）。

导入 "通用控件包"

定义 事件_加1():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) + 1))

定义 事件_减1():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) - 1))

定义 事件_翻倍():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) * 2))

定义 事件_清零():
    界面_设置("计数", "0")
    界面_设置("奇偶", "?")

定义 事件_奇偶():
    如果 转数字(界面_取("计数")) % 2 == 0:
        界面_设置("奇偶", "偶数")
    否则:
        界面_设置("奇偶", "奇数")

定义 事件_返回主页():
    界面_返回()

定义 事件_调整星级(变量, 值):
    界面_设置(变量, 值)
    打印(_vaz_星级文本(值))

定义 事件_打开设置():
    界面_显示("vua_settings.vua")
    界面_绑定("返回主页", 事件_返回主页)

// ==================== 课表（测试能力：Java 网络桥 + JSON_解析 + 动态渲染树） ====================
// 流程：点"打开课表"进 vua_class 页 → 点"下载并显示课表" →
// 网络_GET(Java 桥) 拉 gitee apk_class.json → JSON_查询/列表_长度 解析 →
// 循环拼接 .vua 渲染树 → 界面_显示_JSON 动态上屏。

定义 事件_打开课表():
    界面_显示("vua_class.vua")

定义 事件_加载课表():
    数据 = 网络_GET("https://gitee.com/rtccn_mc/vus/raw/master/apk_class.json")
    如果 数据 == "":
        打印("课表下载失败（网络不可用或 JSON 为空）")
        返回
    结束
    标题 = 对象文本(JSON_查询(数据, "标题"))
    星期数 = 列表_长度(JSON_查询(数据, "星期"))
    节数 = 列表_长度(JSON_查询(数据, "节次"))
    表头行 = "{\"type\":\"行\",\"子组件\":[{\"type\":\"文本\",\"样式\":\"title\",\"内容\":\"节次/星期\"}"
    循环 j 从 0 到 星期数 - 1:
        表头行 = 表头行 + ",{\"type\":\"文本\",\"样式\":\"title\",\"内容\":\"" + 对象文本(JSON_查询(数据, "星期[" + j + "]")) + "\"}"
    结束
    表头行 = 表头行 + "]}"
    行串 = ""
    循环 i 从 0 到 节数 - 1:
        行体 = "{\"type\":\"行\",\"子组件\":[{\"type\":\"文本\",\"内容\":\"" + 对象文本(JSON_查询(数据, "节次[" + i + "]")) + "\"}"
        循环 j 从 0 到 星期数 - 1:
            行体 = 行体 + ",{\"type\":\"文本\",\"内容\":\"" + 对象文本(JSON_查询(数据, "课程[" + i + "][" + j + "]")) + "\"}"
        结束
        行体 = 行体 + "]}"
        如果 i == 0:
            行串 = 行体
        否则:
            行串 = 行串 + "," + 行体
        结束
    结束
    树 = "{\"type\":\"界面\",\"标题\":\"" + 标题 + "\",\"子组件\":[" + 表头行 + "," + 行串 + "]}"
    界面_显示_JSON(树)

定义 事件_打开逻辑():
    界面_显示("vua_logic.vua")
    界面_绑定("返回主页", 事件_返回主页)
    界面_绑定("加1", 事件_加1)
    界面_绑定("减1", 事件_减1)
    界面_绑定("翻倍", 事件_翻倍)
    界面_绑定("清零", 事件_清零)
    界面_绑定("检查奇偶", 事件_奇偶)

界面_显示("vua_home.vua")
界面_绑定("打开逻辑", 事件_打开逻辑)
界面_绑定("打开设置", 事件_打开设置)
界面_绑定("打开课表", 事件_打开课表)
界面_绑定("加载课表", 事件_加载课表)
界面_绑定("执行搜索", _vaz_执行搜索)
界面_绑定("调整星级", 事件_调整星级)
