// vua_test.vus — VUA Android 组件流 冒烟逻辑
// 多屏导航：主页 → 逻辑测试页 / 设置页 → 返回主页。
// 逻辑页用 界面_设置 / 界面_取 维护状态，渲染树变量回填实时显示。
// 顶部导入 .vaz 依赖包 "通用控件包" 的逻辑库（构建期由编译器内建展开）。

导入 "通用控件包"

定义 事件_加1():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) + 1))

定义 事件_减1():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) - 1))

定义 事件_翻倍():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) * 2))

定义 事件_清零():
    界面_设置("计数", "0")
    界面_设置("奇偶", "?")

定义 事件_奇偶():
    如果 转数字(界面_取("计数")) % 2 == 0:
        界面_设置("奇偶", "偶数")
    否则:
        界面_设置("奇偶", "奇数")

定义 事件_返回主页():
    界面_返回()

// ==================== DEX 逻辑拓展（拓展_调用 → Java 平台桥 ext.* → ExtensionLoader） ====================
// 插件 dex 由 APK 内置（assets/plugins/sample.dex），也可运行期用 网络_下载 热更新。

定义 事件_拓展求和():
    响应 = 拓展_调用("sample.sum", "{\"a\":11,\"b\":22}")
    打印("拓展响应: " + 响应)
    如果 对象文本(JSON_查询(响应, "ok")) == "真":
        界面_设置("拓展结果", "sum(11,22) = " + 对象文本(JSON_查询(响应, "data")))
    否则:
        界面_设置("拓展结果", "err: " + 对象文本(JSON_查询(响应, "err")))
    结束

定义 事件_拓展阶乘():
    响应 = 拓展_调用("sample.factorial", "{\"n\":10}")
    如果 对象文本(JSON_查询(响应, "ok")) == "真":
        界面_设置("拓展结果", "10! = " + 对象文本(JSON_查询(响应, "data")))
    否则:
        界面_设置("拓展结果", "err: " + 对象文本(JSON_查询(响应, "err")))
    结束

定义 事件_调整星级(变量, 值):
    界面_设置(变量, 值)
    打印(_vaz_星级文本(值))

定义 事件_打开设置():
    界面_显示("vua_settings.vua")
    界面_绑定("返回主页", 事件_返回主页)

// ==================== 高级能力演示页（长列表 / 富文本 / 远程图片） ====================
// 列表行点击 → 事件_选择记录(下标, 值)；滚动到底 → "加载更多"（分页由 .vus 控制）。
定义 事件_打开高级():
    界面_显示("vua_advanced.vua")
    界面_绑定("返回主页", 事件_返回主页)
    界面_绑定("选择记录", 事件_选择记录)
    界面_绑定("加载更多", 事件_加载更多)

定义 事件_选择记录(下标, 值):
    界面_设置("选中记录", "第 " + 下标 + " 行：" + 值)

定义 事件_加载更多():
    次数 = 转数字(界面_取("列表提示计数"))
    次数 = 次数 + 1
    界面_设置("列表提示计数", 转文本(次数))
    界面_设置("列表提示", "已触发加载更多 " + 转文本(次数) + " 次（分页逻辑在此）")

// ==================== 课表（测试能力：Java 网络桥 + JSON_解析 + 课表控件 + 动态渲染树） ====================
// 流程：点"打开课表"进 vua_class 页 → 点"下载并显示课表" →
// 网络_GET(Java 桥) 拉 gitee apk_class.json → JSON_查询 取结构化数据 →
// JSON_生成 把星期/节次/课程数组序列化 → 拼成「课表」控件节点 → 界面_显示_JSON 上屏。

定义 事件_打开课表():
    界面_显示("vua_class.vua")

定义 事件_加载课表():
    数据 = 网络_GET("https://gitee.com/rtccn_mc/vus/raw/master/apk_class.json")
    如果 数据 == "":
        打印("课表下载失败（网络不可用或 JSON 为空）")
        返回
    结束
    标题 = 对象文本(JSON_查询(数据, "标题"))
    星期串 = JSON_生成(JSON_查询(数据, "星期"))
    节次串 = JSON_生成(JSON_查询(数据, "节次"))
    课程串 = JSON_生成(JSON_查询(数据, "课程"))
    树 = "{\"type\":\"界面\",\"标题\":\"" + 标题 + "\",\"子组件\":[{\"type\":\"课表\",\"标题\":\"" + 标题 + "\",\"星期\":" + 星期串 + ",\"节次\":" + 节次串 + ",\"课程\":" + 课程串 + "}]}"
    界面_显示_JSON(树)

定义 事件_打开逻辑():
    界面_显示("vua_logic.vua")
    界面_绑定("返回主页", 事件_返回主页)
    界面_绑定("加1", 事件_加1)
    界面_绑定("减1", 事件_减1)
    界面_绑定("翻倍", 事件_翻倍)
    界面_绑定("清零", 事件_清零)
    界面_绑定("检查奇偶", 事件_奇偶)
    界面_绑定("拓展求和", 事件_拓展求和)
    界面_绑定("拓展阶乘", 事件_拓展阶乘)

// ==================== 热更新测试（参照 docs.vus） ====================
// 内置 sample.dex 为 v1（无 greet）：点「更新插件」下载 gitee 上的 v2 dex 到
// filesDir/plugins/，ExtensionLoader 检测文件变更自动重建 ClassLoader（实时生效）。
定义 更新插件地址():
    返回 "https://gitee.com/rtccn_mc/vus/raw/master/examples/vua-android/plugins/dist/sample.dex"

定义 更新插件校验地址():
    返回 "https://gitee.com/rtccn_mc/vus/raw/master/examples/vua-android/plugins/dist/sample.dex.sha256"

定义 更新清单地址():
    返回 "https://gitee.com/rtccn_mc/vus/raw/master/examples/vua-android/dist/manifest.json"

// 更新插件：下载 dex + sha256 到 plugins/，实时生效（无需重启）。
定义 事件_更新插件():
    界面_设置("热更状态", "从 gitee 拉取插件 dex …")
    路径 = "plugins/sample.dex"
    r1 = 网络_下载(更新插件地址(), 路径)
    如果 r1 != "1":
        界面_设置("热更状态", "插件 dex 下载失败（网络或地址错误）")
        返回
    结束
    r2 = 网络_下载(更新插件校验地址(), 路径 .. ".sha256")
    如果 r2 != "1":
        界面_设置("热更状态", "插件已下载，但 SHA-256 校验文件获取失败")
        返回
    结束
    界面_设置("热更状态", "插件已热更(v2)，点「测拓展」验证 greet")

// 测拓展：sum 为 v1 已有操作；greet 仅 v2 有 → 更新前报未知操作、更新后成功，即证明 dex 热更生效。
定义 事件_测拓展():
    响应 = 拓展_调用("sample.sum", "{\"a\":11,\"b\":22}")
    如果 对象文本(JSON_查询(响应, "ok")) == "真":
        界面_设置("热更状态", "sum(11,22) = " + 对象文本(JSON_查询(响应, "data")))
    否则:
        界面_设置("热更状态", "拓展调用失败: " + 对象文本(JSON_查询(响应, "err")) + " → 先点「更新插件」")
        返回
    结束
    响应2 = 拓展_调用("sample.greet", "{\"msg\":\"VUS\"}")
    如果 对象文本(JSON_查询(响应2, "ok")) == "真":
        界面_设置("热更状态", 对象文本(JSON_查询(响应2, "data")))
    否则:
        界面_设置("热更状态", "sum 正常，但 greet 不可用(旧版插件) → 点「更新插件」热更新")

// 加载SO(重启生效)：经热更协议 applyUpdate 应用含新 .so 的更新包。
// 实时文件（.vua/.dex）立即可用；.so 由 VuaBridge.ensureNative 下次启动优先加载。
定义 事件_加载SO():
    界面_设置("热更状态", "应用含新 .so 的更新包…")
    码 = 热更_应用(更新清单地址())
    如果 码 == "0":
        界面_设置("热更状态", "新 .so 已就位：重启 APK 生效")
    否则如果 码 == "1":
        界面_设置("热更状态", "无更新（版本 ≤ 当前）")
    否则如果 码 == "-1":
        界面_设置("热更状态", "宿主版本过低，拒绝更新包")
    否则:
        界面_设置("热更状态", "更新包应用失败(" + 码 + ")：清单未发布或网络错误")

界面_显示("vua_home.vua")
界面_绑定("打开逻辑", 事件_打开逻辑)
界面_绑定("打开设置", 事件_打开设置)
界面_绑定("打开课表", 事件_打开课表)
界面_绑定("加载课表", 事件_加载课表)
界面_绑定("执行搜索", _vaz_执行搜索)
界面_绑定("调整星级", 事件_调整星级)
界面_绑定("更新插件", 事件_更新插件)
界面_绑定("测拓展", 事件_测拓展)
界面_绑定("加载SO", 事件_加载SO)
