// vua_test.vus — VUA Android 组件流 冒烟逻辑
// 多屏导航：主页 → 逻辑测试页 / 设置页 → 返回主页。
// 逻辑页用 界面_设置 / 界面_取 维护状态，渲染树变量回填实时显示。

定义 事件_加1():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) + 1))

定义 事件_减1():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) - 1))

定义 事件_翻倍():
    界面_设置("计数", 转文本(转数字(界面_取("计数")) * 2))

定义 事件_清零():
    界面_设置("计数", "0")
    界面_设置("奇偶", "?")

定义 事件_奇偶():
    如果 转数字(界面_取("计数")) % 2 == 0:
        界面_设置("奇偶", "偶数")
    否则:
        界面_设置("奇偶", "奇数")

定义 事件_返回主页():
    界面_返回()

定义 事件_打开设置():
    界面_显示("vua_settings.vua")
    界面_绑定("返回主页", 事件_返回主页)

定义 事件_打开逻辑():
    界面_显示("vua_logic.vua")
    界面_绑定("返回主页", 事件_返回主页)
    界面_绑定("加1", 事件_加1)
    界面_绑定("减1", 事件_减1)
    界面_绑定("翻倍", 事件_翻倍)
    界面_绑定("清零", 事件_清零)
    界面_绑定("检查奇偶", 事件_奇偶)

界面_显示("vua_home.vua")
界面_绑定("打开逻辑", 事件_打开逻辑)
界面_绑定("打开设置", 事件_打开设置)
