#// 测试：列表/字典字面量（回归：vus_ast_node_free 内存释放覆盖）
#// 覆盖 VUS_AST_LIST_LITERAL / VUS_AST_DICT_LITERAL 节点的解析、生成与运行

#// 列表字面量
ls = [10, 20, 30]
打印("列表: ")
打印(ls)
打印("\n")

#// 嵌套列表字面量
nested = [[1, 2], [3, 4]]
打印("嵌套列表: ")
打印(nested)
打印("\n")

#// 字典字面量
dict1 = {"名称": "VUS", "版本": 1}
打印("字典: ")
打印(dict1)
打印("\n")

#// 空列表与空字典
empty_list = []
empty_dict = {}
打印("空列表: ")
打印(empty_list)
打印(" 空字典: ")
打印(empty_dict)
打印("\n")

打印("=== 字面量测试完成 ===\n")
