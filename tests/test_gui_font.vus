#// 测试：外部字体加载与渲染（FreeType，headless）
#// 覆盖 未加载查询 / 加载缺失文件 / 加载真实TTF / 不同字号 / 中英文混合 / MD折行接入
#// 验证返回码不崩溃；成功=1，失败=0

打印("GUI外部字体测试开始\n")

r = 图形_初始化(320, 240, "外部字体测试")
打印("初始化=")
打印(r)
打印("\n")

字体 = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"

# ---- 未加载时查询已加载：应为 0 ----
r = 图形_字体已加载()
打印("初始已加载=")
打印(r)
打印("\n")

# ---- 加载不存在的字体：应返回 0，不崩溃 ----
r = 图形_字体_加载("/no/such/font.ttf", 16)
打印("加载缺失字体=")
打印(r)
打印("\n")

# ---- 加载真实 TTF：应返回 1 ----
r = 图形_字体_加载(字体, 16)
打印("加载DejaVu(16px)=")
打印(r)
打印("\n")

r = 图形_字体已加载()
打印("加载后已加载=")
打印(r)
打印("\n")

# ---- 外部字体绘制文本：不同字号叠加 ----
r = 图形_文字(10, 10, "Hello VUS", 0xFFFFFF)
打印("绘制16px文本=")
打印(r)
打印("\n")

# 切更大字号再绘制
r = 图形_字体_加载(字体, 24)
打印("切换24px=")
打印(r)
打印("\n")
r = 图形_文字(10, 40, "Large Size", 0x00FF00)
打印("绘制24px文本=")
打印(r)
打印("\n")

# ---- 中英文混合（DejaVu 无中文，验证不崩溃）----
r = 图形_字体_加载(字体, 20)
打印("切换20px=")
打印(r)
打印("\n")
r = 图形_文字(10, 80, "混合 Mixed 123", 0xFF8800)
打印("绘制中英文混合=")
打印(r)
打印("\n")

# ---- MD 折行接入外部字体（真实宽度度量）----
md = "# 标题\n一段较长的正文用于折行测试 with some english words\n- 列表项\n"
行数 = 图形_MD(10, 120, 150, md)
打印("MD外部字体折行数=")
打印(行数)
打印("\n")

r = 图形_刷新()
打印("刷新=")
打印(r)
打印("\n")

打印("GUI外部字体测试结束\n")