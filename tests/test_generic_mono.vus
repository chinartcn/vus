#// 泛型真实实例化（单态化）专项测试
#// 覆盖：泛型调泛型（类型形参经实例映射解析）、递归泛型、多类型实参、未使用泛型不发射

定义 包装打印<T>(x):
    返回 "[" .. x .. "]"

#// 泛型体内调用另一个泛型：T 在 包装<int> 实例内被解析为 int
定义 包装<T>(x):
    返回 包装打印<T>(x)

#// 递归泛型：同一函数多个类型实参各自递归实例化
定义 阶乘展<U>(n):
    如果 n <= 1:
        返回 "1"
    返回 阶乘展<U>(n - 1) .. "."

a = 包装<int>(7)
b = 包装打印<string>("hi")
c = 阶乘展<int>(3)
d = 阶乘展<string>(2)

打印(a)
打印("\n")
打印(b)
打印("\n")
打印(c)
打印("\n")
打印(d)
打印("\n")

#// 期望：a=[7]  b=[hi]  c=1..  d=1.
如果 a == "[7]":
    如果 b == "[hi]":
        如果 c == "1..":
            如果 d == "1.":
                打印("泛型单态化测试通过\n")
            否则:
                打印("d 断言失败: " .. d .. "\n")
        否则:
            打印("c 断言失败: " .. c .. "\n")
    否则:
        打印("b 断言失败: " .. b .. "\n")
否则:
    打印("a 断言失败: " .. a .. "\n")