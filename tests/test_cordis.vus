# Cordis 式上下文元框架（路线 A+B）测试
# 覆盖：DI 拓扑激活（依赖先于依赖者）、服务获取、effect 逆序回退、事件 EMIT 广播

# ---- 1. DI 拓扑：存储 依赖 日志 —— 存储 后注册，激活仍按 日志 → 存储（依赖先就绪） ----
定义 日志_初始化(_impl):
    打印("初始化: 日志")
定义 日志_拆卸(_impl):
    打印("拆卸: 日志")
定义 存储_初始化(_impl):
    打印("初始化: 存储")
定义 存储_拆卸(_impl):
    打印("拆卸: 存储")

注册服务 ("日志", {初始化: 日志_初始化, 拆卸: 日志_拆卸, 数据: "日志数据"})
注册服务 ("存储", {依赖: ["日志"], 初始化: 存储_初始化, 拆卸: 存储_拆卸, 数据: "存储数据"})

断言(服务获取 ("存储") == "存储数据", "服务获取: impl 数据")
断言(服务获取 ("日志") == "日志数据", "服务获取: 依赖服务")

# ---- 2. 事件 EMIT 广播（按注册顺序通知全部观察者） ----
定义 观察者甲(_参数):
    打印("事件: 甲")
定义 观察者乙(_参数):
    打印("事件: 乙")
监听事件 ("消息", 观察者甲, "观察")
监听事件 ("消息", 观察者乙, "观察")
发射事件 ("消息", "hello")

# ---- 3. effect 栈：exit 时逆序回退（先乙后甲） ----
定义 撤销甲(_d):
    打印("回退: 甲")
定义 撤销乙(_d):
    打印("回退: 乙")
挂载效果 (撤销甲, "a")
挂载效果 (撤销乙, "b")

# ---- 4. WATERFALL 管线：按注册顺序执行，无短路时全部通过 ----
定义 中间件甲(_参数):
    打印("中间件: 甲")
定义 中间件乙(_参数):
    打印("中间件: 乙")
监听事件 ("管线", 中间件甲, "中间件")
监听事件 ("管线", 中间件乙, "中间件")
管线事件 ("管线", "x", "中间件")

# ---- 5. 依赖缺失：注册被拒绝但不崩溃（该服务不可获取） ----
注册服务 ("孤儿", {依赖: ["幽灵"], 数据: "孤儿数据"})
断言(服务获取 ("孤儿") == "", "缺失依赖的服务不可获取")

# ---- 6. 事件载荷为 NEW 字符串（计算表达式出生份被 RAII 收割，不泄漏） ----
定义 观察者丙(_参数):
    断言(转数字(_参数) >= 3, "NEW 载荷正确传递")
定义 观察者丁(_参数):
    断言(转数字(_参数) >= 3, "NEW 载荷多观察者送达")
监听事件 ("载荷", 观察者丙, "观察")
监听事件 ("载荷", 观察者丁, "观察")
载荷基数 = 1
发射事件 ("载荷", 载荷基数 + 2)
循环 j 从 1 到 200:
    发射事件 ("载荷", j + 2)

# ---- 7. 零参监听器：NEW 载荷发射不崩（无 UAF/越界读） ----
定义 空观察者():
    打印("空观察者")
监听事件 ("空", 空观察者, "观察")
发射事件 ("空", 载荷基数 + 5)

# ---- 8. WATERFALL 管线带计算载荷 ----
定义 管线甲(_参数):
    断言(_参数 == "4", "管线计算载荷")
监听事件 ("管线2", 管线甲, "中间件")
管线事件 ("管线2", 载荷基数 + 3, "中间件")

打印("test_cordis ok")