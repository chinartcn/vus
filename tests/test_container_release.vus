#// 字典/列表递归释放回归：嵌套容器（列表套字典、字典套列表）、
#// 共享/驻留字面量场景下不应崩溃或非法释放。
#// 重点验证 vus_unref 归零时的递归释放路径（正常结束即验证不崩）。

打印("=== 嵌套容器递归释放测试开始 ===\n")

# 1) 列表套字典：元素是字典，字典值又是列表
外层列表 = [ {"甲": "1", "乙": "2"}, {"丙": "3", "丁": "4"} ]
打印("外层长度=")
打印(列表_长度(外层列表))
打印("\n首元素甲=")
打印(字典_取值(列表_取(外层列表, 0), "甲"))
打印("\n")

# 2) 字典套列表：字典的值是列表，列表元素又是字典
嵌套字典 = {"内层": [ {"x":"9"}, [1,2] ]}
打印("字典值首元素x=")
打印(字典_取值(列表_取(字典_取值(嵌套字典, "内层"), 0), "x"))
打印("\n")

# 3) 嵌套字面量直接赋值并丢弃：每次循环覆盖旧容器 → 触发归零递归释放
循环 i 从 1 到 20:
    临时 = [ {"n": 转文本(i)}, [i, "深层", {"x":"驻留"} ] ]
    临时 = {"覆盖": 临时}     #// 旧容器被覆盖，递归释放 [字典+列表]

# 4) JSON 嵌套对象释放（列表+字典组合树）
数据 = JSON_解析("{\"a\":{\"b\":[1,2,{\"c\":\"深\"}]},\"d\":\"标的\"}")
打印("键a=")
打印(JSON_查询("{\"a\":{\"b\":[1,2,{\"c\":\"深\"}]},\"d\":\"标的\"}", "a"))
打印("\n")

打印("=== 嵌套容器递归释放测试结束 ===\n")