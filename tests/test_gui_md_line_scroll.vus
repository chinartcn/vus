#// 测试：图形_MD 渲染 / 画线增强 / 滚动容器（headless）
#// 覆盖 图形_MD/图形_画线(线宽,虚线,箭头,缺省)/图形_滚动容器/滚/偏移
#// headless 下无真实滚轮，验证登记、偏移增减与返回不崩溃、数值合理

打印("GUI MD/画线/滚动测试开始\n")

r = 图形_初始化(320, 240, "MD/画线/滚动测试")
打印("初始化=")
打印(r)
打印("\n")

# ---- 图形_MD：标题/列表/引用/代码块/段落/分隔线，返回占用行数 ----
md = "# 标题行\n- 无序项一\n- 无序项二\n1. 有序项\n> 引用内容\n```\ncode line\n```\n正文段落\n---\n"
行数 = 图形_MD(5, 5, 200, md)
打印("MD占用行数=")
打印(行数)
打印("\n")

# 空文本应返回 0
空行数 = 图形_MD(5, 5, 200, "")
打印("MD空文本行数=")
打印(空行数)
打印("\n")

# ---- 图形_画线增强：宽线/虚线/箭头 ----
r = 图形_画线(10, 200, 100, 240, 0xFF0000, 3, 0, 0)
打印("画线(宽线)=")
打印(r)
打印("\n")

# 虚线 + 箭头
r = 图形_画线(110, 200, 200, 240, 0x00FF00, 1, 1, 1)
打印("画线(虚线箭头)=")
打印(r)
打印("\n")

# 旧 5 参兼容：缺省线宽/虚线/箭头
r = 图形_画线(10, 10, 110, 10, 0x0000FF)
打印("画线(旧5参)=")
打印(r)
打印("\n")

# ---- 滚动容器 ----
r = 图形_滚动容器("列表", 10, 60, 300, 100, 300)
打印("滚动容器登记=")
打印(r)
打印("\n")

偏移 = 图形_滚动容器偏移("列表")
打印("滚动容器初始偏移=")
打印(偏移)
打印("\n")

r = 图形_滚动容器滚("列表", 30)
打印("滚动容器下滚30=")
打印(r)
打印("\n")

r = 图形_滚动容器滚("列表", -10)
打印("滚动容器上滚10=")
打印(r)
打印("\n")

# 未登记名称：应返回 0 不崩溃
r = 图形_滚动容器偏移("不存在的容器")
打印("未登记偏移=")
打印(r)
打印("\n")

r = 图形_滚动容器滚("不存在的容器", 5)
打印("未登记滚=")
打印(r)
打印("\n")

打印("GUI MD/画线/滚动测试结束\n")