#// 测试：逻辑运算符 and(和) 和 or(或)
#// 验证逻辑与、逻辑或的短路求值

a = 1
b = 0
c = 1

#// 测试 and 逻辑与
如果 a 和 c:
    打印("a 和 c 都为真\n")
否则:
    打印("a 和 c 不都为真\n")

#// 测试 and 短路：b 为 0（假）
如果 b 和 a:
    打印("b 和 a 都为真\n")
否则:
    打印("b 和 a 不都为真\n")

#// 测试 or 逻辑或
如果 a 或 b:
    打印("a 或 b 为真\n")
否则:
    打印("a 或 b 为假\n")

#// 测试 or 全假
如果 b 或 0:
    打印("b 或 0 为真\n")
否则:
    打印("b 或 0 为假\n")

#// 测试复杂逻辑组合
如果 (a 和 c) 或 b:
    打印("(a 和 c) 或 b 为真\n")
否则:
    打印("(a 和 c) 或 b 为假\n")

#// 测试逻辑与比较组合
x = 10
如果 x > 5 和 x < 20:
    打印("x 在 5 和 20 之间\n")
否则:
    打印("x 不在范围内\n")

打印("逻辑运算测试完成\n")