#// 测试：否则如果（elif）多条件分支
#// 验证多个 elif 分支的正确执行

打印("=== elif 多条件分支测试 ===\n")

分数 = 85

#// 测试完整的多分支
如果 分数 >= 90:
    打印("A\n")
否则如果 分数 >= 80:
    打印("B\n")
否则如果 分数 >= 70:
    打印("C\n")
否则如果 分数 >= 60:
    打印("D\n")
否则:
    打印("F\n")

#// 测试只有一个 elif 匹配
值 = 0
如果 值 > 0:
    打印("正数\n")
否则如果 值 < 0:
    打印("负数\n")
否则:
    打印("零\n")

#// 测试 elif 短路（第一个匹配即停止）
数字 = 50
如果 数字 > 10:
    打印("大于 10\n")
否则如果 数字 > 30:
    打印("大于 30\n")
否则如果 数字 > 80:
    打印("大于 80\n")
否则:
    打印("都不大于\n")

打印("elif 测试完成\n")