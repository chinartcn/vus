// test_platform_light.vus — Android 轻量能力（振动/剪贴板/设备信息/提示）桌面降级冒烟
// APK 内这些内建走 Java 平台桥（真振动/剪贴板/Toast）；桌面执行验证降级路径不崩且值合法。
打印("剪贴板_读(桌面回退应为空): [" .. 剪贴板_读() .. "]\n")
打印("剪贴板_写: " .. 剪贴板_写("hello") .. "\n")
打印("振动: " .. 振动(100) .. "\n")
打印("提示(短): " .. 提示("hi") .. "\n")
打印("提示(长): " .. 提示("hello world", 1) .. "\n")
信息 = JSON_解析(设备_信息())
打印("设备_信息.品牌: " .. 对象文本(JSON_查询(信息, "品牌")) .. "\n")
打印("设备_信息.型号: " .. 对象文本(JSON_查询(信息, "型号")) .. "\n")

// 系统能力延伸（桌面降级断言）
打印("分享_文本: " .. 分享_文本("hello") .. "\n")
打印("屏幕_常亮: " .. 屏幕_常亮(1) .. " / " .. 屏幕_常亮(0) .. "\n")
打印("网络_类型(桌面回退应 none): " .. 网络_类型() .. "\n")
打印("通知_发送: " .. 通知_发送("标题", "内容") .. "\n")
电源 = JSON_解析(电源_电量())
打印("电源_电量(桌面回退应 -1): " .. 对象文本(JSON_查询(电源, "电量")) .. "\n")

// 主题（桌面无害降级）
打印("主题_设置: " .. 主题_设置("暗色") .. " / " .. 主题_设置("浅色") .. "\n")
打印("主题_查询(桌面回退应 浅色): " .. 主题_查询() .. "\n")
打印("[PLATFORM] 冒烟完成\n")