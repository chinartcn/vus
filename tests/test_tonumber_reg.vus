#// 回归测试：转数字 作为表达式（赋值/打印/算术/条件）不再段错误
#// 覆盖此前“数值地址被当 VusString* 引用”的编译缺陷修复

打印("转数字回归测试开始\n")

定义 加(a, b):
    返回 转数字(a) + 转数字(b)

# 赋值场景（此前崩溃点）
x = 转数字("123")
打印("x=")
打印(x)
打印("\n")

# 打印场景
打印("直接=")
打印(转数字("45"))
打印("\n")

# 算术场景
y = 转数字("7") * 转数字("3")
打印("7*3=")
打印(y)
打印("\n")

# 函数内返回并比较
z = 加("10", "20")
打印("加(10,20)=")
打印(z)
如果 转数字(z) == 30:
    打印(" 通过\n")
否则:
    打印(" 失败\n")

# 负数字符串
n = 转数字("-5")
打印("负=")
打印(n)
如果 转数字(n) < 0:
    打印(" 通过\n")
否则:
    打印(" 失败\n")

打印("转数字回归测试结束\n")