#// 测试：文件操作 + Shell 命令执行 + 文本分割
#// 覆盖 文件_写入/读取/追加/存在/删除/列表/是目录 + 命令_执行 + 文本_分割
打印("=== 文件/Shell 测试开始 ===\n")

#// 1. 文件_写入 + 文件_读取
r = 文件_写入("/tmp/vus_test.txt", "hello vus")
打印("文件_写入: ")
打印(r)
打印("\n")

内容 = 文件_读取("/tmp/vus_test.txt")
打印("读取内容: ")
打印(内容)
打印("\n")
如果 内容 == "hello vus":
    打印("文件读写: 通过\n")
否则:
    打印("文件读写: 失败\n")

#// 2. 文件_存在
e = 文件_存在("/tmp/vus_test.txt")
打印("存在已创建: ")
打印(e)
打印("\n")

e2 = 文件_存在("/tmp/不存在的文件_xyz")
打印("存在不存在的: ")
打印(e2)
打印("\n")
如果 e == "1" 和 e2 == "0":
    打印("文件存在判断: 通过\n")
否则:
    打印("文件存在判断: 失败\n")

#// 3. 文件_追加 + 验证
r2 = 文件_追加("/tmp/vus_test.txt", " appended")
打印("追加结果: ")
打印(r2)
打印("\n")

内容2 = 文件_读取("/tmp/vus_test.txt")
打印("追加后内容: ")
打印(内容2)
打印("\n")
如果 内容2 == "hello vus appended":
    打印("文件追加: 通过\n")
否则:
    打印("文件追加: 失败\n")

#// 4. 文件_删除
r3 = 文件_删除("/tmp/vus_test.txt")
打印("删除结果: ")
打印(r3)
打印("\n")
e3 = 文件_存在("/tmp/vus_test.txt")
如果 e3 == "0":
    打印("文件删除: 通过\n")
否则:
    打印("文件删除: 失败\n")

#// 5. 文件_列表
列表 = 文件_列表("/tmp")
打印("文件列表非空: ")
如果 列表 != "":
    打印("通过\n")
否则:
    打印("失败(空列表)\n")

#// 6. 文件_是目录
isdir = 文件_是目录("/tmp")
打印("/tmp 是目录: ")
打印(isdir)
打印("\n")
isnotdir = 文件_是目录("/tmp/vus_test_xyz_not_exist")
打印("不存在的是目录: ")
打印(isnotdir)
打印("\n")
如果 isdir == "true":
    打印("目录判断: 通过\n")
否则:
    打印("目录判断: 失败\n")

#// 7. 命令_执行
输出 = 命令_执行("echo test123")
打印("命令输出: ")
打印(输出)
打印("\n")
如果 输出 == "test123\n":
    打印("命令执行: 通过\n")
否则:
    打印("命令执行: 失败(输出=\"" .. 输出 .. "\")\n")

#// 8. 文本_分割 直接返回列表（P7）+ 旧写法 JSON_解析 幂等兼容 + 文本_行
分割 = 文本_分割("a,bb,ccc", ",")
打印("分割结果: ")
打印(分割)
打印("\n")
打印("分割数量: ")
打印(列表_长度(分割))
打印("\n")
打印("遍历分割:")
循环 元素 在 分割:
    打印(" ")
    打印(元素)
打印("\n")
#// 旧写法兼容：JSON_解析(文本_分割(...)) 依旧返回同一列表
旧arr = JSON_解析(文本_分割("a,bb,ccc", ","))
打印("旧写法兼容数量: ")
打印(列表_长度(旧arr))
打印("\n")
#// 文本_行：按换行一步到位拆成列表
行 = 文本_行("第一行\n第二行")
打印("文本_行: ")
循环 元素 在 行:
    打印("[")
    打印(元素)
    打印("]")
打印("\n")

打印("=== 文件/Shell 测试完成 ===\n")