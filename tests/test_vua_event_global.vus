// test_vua_event_global.vus — 事件函数内读写全局变量（反馈 P1 核心场景）
全局计数 = 0

定义 事件_加():
    全局计数 = 全局计数 + 1

定义 事件_乘2加1():
    全局计数 = 全局计数 * 2 + 1

定义 事件_设值(值):
    全局计数 = 转数字(值)

定义 主():
    界面_显示("testdata/vua_home.vua")
    界面_绑定("加", 事件_加)
    界面_绑定("乘2加1", 事件_乘2加1)
    界面_绑定("设值", 事件_设值)
    界面_设置("初始", 转文本(全局计数))

主()