# 终端猜数字小游戏：TUI + Python ABI + .vux 插件 三链路综合测试
# 前置：插件装入 ~/.vus/plugins/猜数游戏（见 run_abilities.sh / vus vux install）
# 运行：VUS_PLUGIN_DIR=../examples vus run tests/test_py_game.vus

导入外部 (游戏, {源: "ext_py.guess_game"})

# ---- 开局：TUI 标题 + Python 出题 ----
tui_清屏()
tui_定位(1, 1)
tui_设置颜色(46, 0)
打印("===== 终端猜数字（1~100，Python 出题 + 裁判）=====\n")
tui_重置()

秘密 = 游戏.生成秘密()
下限 = 1
上限 = 游戏.上限
回合 = 0

# ---- 二分对局：每轮 Python 给中点 + 裁判反馈，TUI 进度条展示收敛 ----
当循环 下限 <= 上限:
    回合 = 回合 + 1
    猜测 = 游戏.中点(下限, 上限)
    反馈 = 游戏.判断(秘密, 猜测)
    tui_定位(3 + 回合, 1)
    打印("第 " .. 回合 .. " 轮  猜测: " .. 猜测 .. " -> " .. 反馈 .. "\n")
    tui_进度条(回合, 7, 40)
    如果 反馈 == "恭喜猜中":
        跳出
    如果 反馈 == "大了":
        上限 = 猜测 - 1
    否则:
        下限 = 猜测 + 1

# ---- 结算：写回 Python 变量 + 插件评价 + TUI 展示 ----
游戏.回合数 = 回合
游戏.最高分 = 回合
tui_定位(5, 1)
tui_设置颜色(33, 0)
打印("猜中秘密数字 " .. 秘密 .. "，用了 " .. 回合 .. " 回合\n")
tui_重置()

评价 = 插件_运行("猜数游戏", 回合)
tui_定位(6, 1)
tui_设置颜色(220, 0)
打印("插件评价: " .. 评价 .. "\n")
tui_重置()

# ---- 断言：Python ABI 变量写回 + 二分效率（100 最坏 7 次）+ 出题范围 ----
断言(游戏.回合数 == 回合, "Python 侧回合数写回")
断言(游戏.最高分 == 回合, "Python 侧最高分写回")
断言(回合 <= 7, "二分查找不超过 7 回合")
断言(秘密 >= 1, "秘密不小于 1")
断言(秘密 <= 100, "秘密不大于 100")

打印("test_py_game ok")
