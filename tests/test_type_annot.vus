#// 测试：类型注解（type annotations）
#// 验证变量和函数参数上的类型注解（使用自定义类型名）

#// 带类型注解的变量声明
姓名: string = "张三"
年龄: number = 25
分数: number = 95

打印("姓名: ")
打印(姓名)
打印("\n")
打印("年龄: ")
打印(年龄)
打印("\n")
打印("分数: ")
打印(分数)
打印("\n")

#// 带类型注解的函数参数
定义 打招呼(名字: string, 次数: number):
    循环 i 从 1 到 次数:
        打印("你好，")
        打印(名字)
        打印("！\n")

打招呼("小明", 2)

#// 带类型注解有返回值
定义 加法(a: number, b: number):
    返回 a + b

结果 = 加法(10, 20)
打印("10 + 20 = ")
打印(结果)
打印("\n")

打印("类型注解测试完成\n")