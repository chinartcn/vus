#// 回归测试：函数参数与函数内局部变量同名
#// 曾经导致 C 编译错误 "redefinition of 'vus_x'"
#// 现在参数在函数顶部声明，局部变量收集须排除参数名

定义 测试(x):
    如果 x > 0:
        x = 1
    返回 x

#// x=5 > 0，进入 if 后 x 被重赋值为 1
结果 = 测试(5)
打印("参数重赋值结果: ")
打印(结果)
打印("\n")

#// 参数保持原值场景
结果2 = 测试(0)
打印("参数未重赋值结果: ")
打印(结果2)
打印("\n")

#// 期望：测试(5)=1，测试(0)=0
如果 结果 == 1:
    如果 结果2 == 0:
        打印("参数遮蔽回归测试通过\n")
    否则:
        打印("参数遮蔽回归测试失败\n")
否则:
    打印("参数遮蔽回归测试失败\n")