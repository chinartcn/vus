cat > calculator.vus << 'EOF'
#// 简单整数计算器（无边框，仅填充背景）
打印("计算器启动\n")

图形_初始化(320, 280, "VUS 计算器")

显示 = "0"
当前 = "0"
上次 = "0"
运算符 = ""
新输入 = 1
运行中 = 1

定义 更新显示():
    显示 = 当前

当循环 运行中 == 1:
    图形_取事件()
    图形_填充(0, 0, 320, 280, 0xF0F0F0)

    # 显示屏（白色背景）
    图形_填充(20, 20, 280, 50, 0xFFFFFF)
    图形_标签("屏幕", 30, 35, 显示, 0x000000)

    # 按钮布局
    图形_按钮("b7", 30, 90, 50, 40, "7")
    图形_按钮("b8", 90, 90, 50, 40, "8")
    图形_按钮("b9", 150, 90, 50, 40, "9")
    图形_按钮("b/", 210, 90, 50, 40, "/")

    图形_按钮("b4", 30, 140, 50, 40, "4")
    图形_按钮("b5", 90, 140, 50, 40, "5")
    图形_按钮("b6", 150, 140, 50, 40, "6")
    图形_按钮("b*", 210, 140, 50, 40, "*")

    图形_按钮("b1", 30, 190, 50, 40, "1")
    图形_按钮("b2", 90, 190, 50, 40, "2")
    图形_按钮("b3", 150, 190, 50, 40, "3")
    图形_按钮("b-", 210, 190, 50, 40, "-")

    图形_按钮("b0", 30, 240, 50, 40, "0")
    图形_按钮("bC", 90, 240, 50, 40, "C")
    图形_按钮("b=", 150, 240, 80, 40, "=")
    图形_按钮("b+", 240, 240, 50, 40, "+")

    # ---- 数字处理 ----
    如果 图形_按钮点击("b0"):
        如果 新输入 == 1:
            当前 = "0"
            新输入 = 0
        否则:
            当前 = 当前 .. "0"
        更新显示()

    如果 图形_按钮点击("b1"):
        如果 新输入 == 1:
            当前 = "1"
            新输入 = 0
        否则:
            当前 = 当前 .. "1"
        更新显示()

    如果 图形_按钮点击("b2"):
        如果 新输入 == 1:
            当前 = "2"
            新输入 = 0
        否则:
            当前 = 当前 .. "2"
        更新显示()

    如果 图形_按钮点击("b3"):
        如果 新输入 == 1:
            当前 = "3"
            新输入 = 0
        否则:
            当前 = 当前 .. "3"
        更新显示()

    如果 图形_按钮点击("b4"):
        如果 新输入 == 1:
            当前 = "4"
            新输入 = 0
        否则:
            当前 = 当前 .. "4"
        更新显示()

    如果 图形_按钮点击("b5"):
        如果 新输入 == 1:
            当前 = "5"
            新输入 = 0
        否则:
            当前 = 当前 .. "5"
        更新显示()

    如果 图形_按钮点击("b6"):
        如果 新输入 == 1:
            当前 = "6"
            新输入 = 0
        否则:
            当前 = 当前 .. "6"
        更新显示()

    如果 图形_按钮点击("b7"):
        如果 新输入 == 1:
            当前 = "7"
            新输入 = 0
        否则:
            当前 = 当前 .. "7"
        更新显示()

    如果 图形_按钮点击("b8"):
        如果 新输入 == 1:
            当前 = "8"
            新输入 = 0
        否则:
            当前 = 当前 .. "8"
        更新显示()

    如果 图形_按钮点击("b9"):
        如果 新输入 == 1:
            当前 = "9"
            新输入 = 0
        否则:
            当前 = 当前 .. "9"
        更新显示()

    # ---- 运算符 ----
    如果 图形_按钮点击("b+"):
        上次 = 当前
        当前 = "0"
        新输入 = 1
        运算符 = "+"

    如果 图形_按钮点击("b-"):
        上次 = 当前
        当前 = "0"
        新输入 = 1
        运算符 = "-"

    如果 图形_按钮点击("b*"):
        上次 = 当前
        当前 = "0"
        新输入 = 1
        运算符 = "*"

    如果 图形_按钮点击("b/"):
        上次 = 当前
        当前 = "0"
        新输入 = 1
        运算符 = "/"

    # ---- 等号 ----
    如果 图形_按钮点击("b="):
        如果 运算符 == "":
            打印("无运算\n")
        否则:
            a = 转数字(上次)
            b = 转数字(当前)
            结果 = 0
            如果 运算符 == "+":
                结果 = a + b
            否则如果 运算符 == "-":
                结果 = a - b
            否则如果 运算符 == "*":
                结果 = a * b
            否则如果 运算符 == "/":
                如果 b == 0:
                    当前 = "Error"
                    打印("除以零错误\n")
                否则:
                    结果 = a / b
            如果 当前 != "Error":
                当前 = 转文本(结果)
            更新显示()
            上次 = "0"
            当前 = "0"
            新输入 = 1
            运算符 = ""

    # ---- 清零 ----
    如果 图形_按钮点击("bC"):
        当前 = "0"
        上次 = "0"
        运算符 = ""
        新输入 = 1
        更新显示()
        打印("清零\n")

    图形_刷新()

图形_保持()
打印("计算器关闭\n")
EOF