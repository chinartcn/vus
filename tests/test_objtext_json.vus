#// 验证 对象文本 内建 + JSON_查询 路径数字拼接（体感音游脚本依赖链路）
数据 = 文件_读取("/tmp/beat_test.chart.json")
打印("count=")
打印(对象文本(JSON_查询(数据, "note_count")))
打印("\n")
循环 i 从 0 到 6:
    打印("t")
    打印(i)
    打印(":")
    打印(对象文本(JSON_查询(数据, "notes[" + i + "].t")))
    打印(" d=")
    打印(对象文本(JSON_查询(数据, "notes[" + i + "].d")))
    打印(" tg=")
    打印(对象文本(JSON_查询(数据, "notes[" + i + "].target")))
    打印("\n")
打印("objtext ok\n")