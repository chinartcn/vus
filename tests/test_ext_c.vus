# 运行期外部桥（FFI Bridge）C 域测试
# 插件：examples/ext_c_plugin/c_math.so（vus_rt_module_entry 入口）
# 覆盖：定参/浮点/字符串/可变参数函数；指针槽/回调槽/只读变量；init 参数；
#       导出变量（宿主槽）双向同步；负向错误路径。

# ---- 1. 导入 + init 参数（基准 10 → 桥层传给 mod_init，计数初值 10） ----
导入外部 (c, {源: "../examples/ext_c_plugin/c_math.so", 参数: {基准: 10}})

断言(c.加法(3, 4) == "7", "定参整数加法")
断言(c.加法(-1, 1) == "0", "负数相加")
断言(c.乘法(2.5, 4.0) == "10", "浮点乘法")
断言(c.拼接("ab", "cd") == "abcd", "字符串拼接")
断言(c.求和(1, 2, 3, 4) == "10", "可变参数求和")
断言(c.求和() == "0", "零参数求和")

# ---- 2. 变量三机制 ----
断言(c.计数 == "10", "init 参数生效（指针槽初值）")
c.计数 = 42
断言(c.计数 == "42", "指针槽读写")
c.比例 = 7
断言(c.比例 == "7", "回调槽读写")
断言(c.版本 == "1.0.0", "只读变量读")

# ---- 3. 导出变量（宿主槽）双向同步 ----
导出变量 (["我的计数"])
我的计数 = 100
断言(c.我的计数 == "100", "宿主槽：VUS 改 → C 经桥读")
我的计数 = 200
断言(c.我的计数 == "200", "宿主槽：连续写")

# ---- 4. 函数内连续读写（同屏状态保持） ----
断言(c.计数 == "42", "指针槽状态保持")

# ---- 5. 负向：错误路径（错误类型恒为 外部错误，捕获断言） ----
尝试:
    c.版本 = "2.0"
捕获 外部错误:
    打印("只读变量拦截 ok")

尝试:
    临时 = c.不存在函数(1)
捕获 外部错误:
    打印("函数不存在拦截 ok")

尝试:
    临时 = c.加法(1)              # 参数个数不符（需 2 个）
捕获 外部错误:
    打印("参数个数拦截 ok")

尝试:
    临时 = c.加法("a", "b")        # 类型不匹配（需整数）
捕获 外部错误:
    打印("参数类型拦截 ok")

尝试:
    c.比例 = "abc"                # 回调槽类型校验
捕获 外部错误:
    打印("回调槽类型拦截 ok")

尝试:
    临时 = c.不存在变量
捕获 外部错误:
    打印("变量不存在拦截 ok")

打印("test_ext_c ok")