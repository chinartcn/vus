# 多插件协作测试：三层插件依赖链 + 初始化期依赖可用性断言
# + 事件 EMIT 广播 + WATERFALL 中间件管线 + effect 逆序回退 + 重复注册拒绝
# 运行：vus run tests/test_cordis_multi.vus

# ============ 0. effect 撤销函数（须先定义，供各插件初始化内挂载） ============
定义 释放连接(_h):
    打印("回退: " .. _h)

# ============ 1. 基础设施插件 ============
定义 日志_初始化(_impl):
    打印("激活: 日志")
    挂载效果 (释放连接, "effect-日志")
定义 日志_拆卸(_impl):
    打印("卸载: 日志")

注册服务 ("日志", {初始化: 日志_初始化, 拆卸: 日志_拆卸, 数据: "日志服务"})
注册服务 ("配置", {数据: "v3.0"})

# ============ 2. 插件层：依赖链 日志+配置 → 网络 → 存储 → 应用 ============
定义 网络_初始化(_impl):
    打印("激活: 网络插件")
    断言(服务获取 ("日志") == "日志服务", "网络初始化时日志可用")
    挂载效果 (释放连接, "effect-网络")
定义 网络_拆卸(_impl):
    打印("卸载: 网络插件")
注册服务 ("网络", {依赖: ["日志", "配置"], 初始化: 网络_初始化, 拆卸: 网络_拆卸, 数据: "http://api"})

定义 存储_初始化(_impl):
    打印("激活: 存储插件")
    断言(服务获取 ("日志") == "日志服务", "存储初始化时日志可用")
    断言(服务获取 ("网络") == "http://api", "存储初始化时网络可用")
    挂载效果 (释放连接, "effect-存储")
定义 存储_拆卸(_impl):
    打印("卸载: 存储插件")
注册服务 ("存储", {依赖: ["网络"], 初始化: 存储_初始化, 拆卸: 存储_拆卸, 数据: "sqlite.db"})

定义 应用_初始化(_impl):
    打印("激活: 应用插件")
    断言(服务获取 ("存储") == "sqlite.db", "应用初始化时存储可用")
    挂载效果 (释放连接, "effect-应用")
定义 应用_拆卸(_impl):
    打印("卸载: 应用插件")
注册服务 ("应用", {依赖: ["存储"], 初始化: 应用_初始化, 拆卸: 应用_拆卸, 数据: "主程序"})

# ============ 3. 服务获取数据断言 + 重复注册拒绝 ============
断言(服务获取 ("配置") == "v3.0", "配置数据")
断言(服务获取 ("网络") == "http://api", "网络数据")
断言(服务获取 ("存储") == "sqlite.db", "存储数据")
断言(服务获取 ("应用") == "主程序", "应用数据")

注册服务 ("日志", {数据: "重复"})
断言(服务获取 ("日志") == "日志服务", "重复注册被拒绝")

# ============ 4. 启动事件 EMIT：多插件按注册顺序广播 ============
定义 网络_上报(_参数):
    打印("网络插件收到: " .. _参数)
定义 存储_上报(_参数):
    打印("存储插件收到: " .. _参数)
定义 应用_上报(_参数):
    打印("应用插件收到: " .. _参数)
监听事件 ("启动", 网络_上报, "观察")
监听事件 ("启动", 存储_上报, "观察")
监听事件 ("启动", 应用_上报, "观察")
发射事件 ("启动", "hello")

# ============ 5. 请求管线 WATERFALL：中间件链按注册顺序 ============
定义 鉴权_中间件(_参数):
    打印("鉴权: " .. _参数)
定义 限流_中间件(_参数):
    打印("限流: " .. _参数)
定义 路由_中间件(_参数):
    打印("路由: " .. _参数)
监听事件 ("请求", 鉴权_中间件, "中间件")
监听事件 ("请求", 限流_中间件, "中间件")
监听事件 ("请求", 路由_中间件, "中间件")
管线事件 ("请求", "GET /api", "中间件")

打印("test_cordis_multi ok")
