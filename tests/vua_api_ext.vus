#// 界面_* 扩展接线验证：界面_触发 / 界面_按ID触发 / 界面_解绑 / 界面_全局置 / 界面_全局取
#// 桌面验证方式（vua.c 需显式链接，见 docs/API_REFERENCE.md）：
#//   ./vus build --c-only tests/vua_api_ext.vus
#//   gcc -Irt 构建/vua_api_ext.c rt/vua.c build/libvus_rt.a -o /tmp/vua_api_ext -lm -ldl -lpthread
#//   /tmp/vua_api_ext

定义 事件_打招呼(名字):
    打印("[事件] 你好，" .. 名字 .. "\n")

定义 事件_无参():
    打印("[事件] 无参回调\n")

定义 事件_按钮甲():
    打印("[事件] 按钮甲\n")

# 1) 会话级全局变量：置 / 取 / 缺失取空
界面_全局置("会话名", "VUS")
打印("全局取=" .. 界面_全局取("会话名") .. "\n")
打印("缺失=" .. 界面_全局取("不存在键") .. "\n")

# 2) 绑定 + 触发（带变量 JSON）
界面_绑定("打招呼", 事件_打招呼)
界面_触发("打招呼", "{\"名字\":\"世界\"}")

# 3) 绑定 + 触发（无参）
界面_绑定("无参", 事件_无参)
界面_触发("无参")

# 4) 解绑后再触发：事件表已移除，仅打印"事件未绑定"
界面_解绑("无参")
界面_触发("无参")

# 5) 按ID触发：动态上屏一棵含按钮(带事件)的树后按 id 派发
树 = "{\"type\":\"界面\",\"标题\":\"t\",\"子组件\":[{\"type\":\"按钮\",\"id\":\"btn1\",\"文字\":\"甲\",\"事件\":{\"事件名\":\"按钮甲\"}}]}"
界面_显示_JSON(树)
界面_绑定("按钮甲", 事件_按钮甲)
界面_按ID触发("btn1")
界面_按ID触发("btn1", "{\"额外\":\"1\"}")   # 带变量 JSON 的按ID触发（事件函数无视多余键）