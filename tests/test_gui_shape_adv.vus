#// 测试：高级外观（圆角矩形/圆角填充/画圆/填充圆/圆弧/外观，headless）
#// 覆盖 圆角外框/实心、圆外框/实心、正跨角圆弧、负跨角圆弧、全局外观圆角按钮。
#// 绘制成功各返回 1。

打印("高级外观测试开始\n")

r = 图形_初始化(320, 240, "高级外观测试")
打印("初始化=")
打印(r)
打印("\n")

# --- 圆角外框 ---
r = 图形_圆角矩形(10, 10, 120, 60, 12, 0x409FFF)
打印("圆角矩形=")
打印(r)
打印("\n")

# --- 圆角实心 ---
r = 图形_圆角填充(150, 10, 120, 60, 15, 0x00AA66)
打印("圆角填充=")
打印(r)
打印("\n")

# --- 画圆（外框）---
r = 图形_画圆(60, 140, 30, 0xFF0000)
打印("画圆=")
打印(r)
打印("\n")

# --- 填充圆（实心）---
r = 图形_填充圆(160, 140, 28, 0x3366FF)
打印("填充圆=")
打印(r)
打印("\n")

# --- 圆弧：0 度正东起顺时针 90 度 ---
r = 图形_圆弧(250, 140, 26, 0, 90, 0xFFAA00)
打印("圆弧(90度)=")
打印(r)
打印("\n")

# --- 圆弧：负跨角度（90 度逆时针 90 度）---
r = 图形_圆弧(285, 140, 18, 90, -90, 0xCC00CC)
打印("圆弧(负跨角)=")
打印(r)
打印("\n")

# --- 外观：设置全局控件圆角半径后按钮改为圆角 ---
r = 图形_外观(10)
打印("外观(半径10)=")
打印(r)
打印("\n")

r = 图形_按钮("圆角钮", 10, 180, 120, 36, "圆角按钮")
打印("圆角按钮=")
打印(r)
打印("\n")

# --- 外观：半径 0 恢复直角按钮 ---
r = 图形_外观(0)
打印("外观(半径0)=")
打印(r)
打印("\n")

r = 图形_按钮("直角钮", 150, 180, 120, 36, "直角按钮")
打印("直角按钮=")
打印(r)
打印("\n")

图形_刷新()
打印("高级外观测试结束\n")