#// 测试：跳出（break）和 继续（continue）语句
#// 验证循环中的跳转控制

打印("=== break 测试 ===\n")

#// 测试 break：找到第一个大于 5 的 3 的倍数
循环 i 从 1 到 20:
    如果 i % 3 == 0:
        如果 i > 5:
            打印("找到: ")
            打印(i)
            打印("\n")
            跳出
打印("break 测试完成\n")

打印("=== continue 测试 ===\n")

#// 测试 continue：只打印奇数
打印("1 到 10 的奇数: ")
循环 i 从 1 到 10:
    如果 i % 2 == 0:
        继续
    打印(i)
    打印(" ")
打印("\n")
打印("continue 测试完成\n")

#// 测试嵌套循环中的 break
打印("=== 嵌套循环 break 测试 ===\n")
循环 i 从 1 到 5:
    循环 j 从 1 到 5:
        如果 i * j > 10:
            跳出
        打印(i * j)
        打印(" ")
    打印("\n")
打印("嵌套 break 测试完成\n")