# 测试插件运行时函数

# 测试文件操作
打印("=== 文件操作测试 ===\n")

# 写入文件
ret = 文件_写入("/tmp/vus_test.txt", "你好，VUS！\n")
打印("写入结果: ")
打印(ret)
打印("\n")

# 读取文件
内容 = 文件_读取("/tmp/vus_test.txt")
打印("读取内容: ")
打印(内容)
打印("\n")

# 检查文件是否存在
存在 = 文件_存在("/tmp/vus_test.txt")
打印("文件存在: ")
打印(存在)
打印("\n")

# 删除文件
删除结果 = 文件_删除("/tmp/vus_test.txt")
打印("删除结果: ")
打印(删除结果)
打印("\n")

# 再次检查
存在2 = 文件_存在("/tmp/vus_test.txt")
打印("删除后存在: ")
打印(存在2)
打印("\n")


# 测试日期时间
打印("=== 日期时间测试 ===\n")

现在 = 日期_现在()
打印("现在: ")
打印(现在)
打印("\n")

时间戳 = 日期_时间戳()
打印("时间戳: ")
打印(时间戳)
打印("\n")

年 = 日期_年()
月 = 日期_月()
日 = 日期_日()
打印("日期: " + 年 + "-" + 月 + "-" + 日 + "\n")


# 测试网络
打印("=== 网络测试 ===\n")
响应 = 网络_GET("https://httpbin.org/get")
打印("网络响应: ")
打印(响应)
打印("\n")

打印("=== 全部测试完成 ===\n")