#// VUS 结构化字面量测试：列表/字典字面量 + typeof + 打印
#// 纯 C 路径，不依赖嵌入式 Python，任何环境均可稳定运行。
#// 覆盖 brooks-lint 报告的 Critical 项：列表/字典字面量被 vus_print/typeof 安全消费。

打印("=== VUS 结构化字面量测试 ===\n")

#// 1. 列表字面量：typeof 识别类型，vus_print 安全输出
列表 = [1, 2, 3]
打印("列表类型: ")
打印(typeof(列表))
打印("\n列表内容: ")
打印(列表)
打印("\n")

#// 2. 字典字面量：typeof 识别类型
字典 = {"a": 1}
打印("字典类型: ")
打印(typeof(字典))
打印("\n")

#// 3. 普通字符串 typeof 仍为"字符串"
文本 = "hello"
打印("字符串类型: ")
打印(typeof(文本))
打印("\n")

打印("=== 测试完成 ===\n")