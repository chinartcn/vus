#// 多返回值测试：定义 返回 a, b, c；接收 a, b = 函数()
定义 计算(x):
    返回 x + 1, x + 2, x + 3

a, b, c = 计算(10)
打印(f"a={a} b={b} c={c}\n")

# 函数内局部多接收
定义 分解(值):
    十位 = 值 / 10
    个位 = 值 % 10
    返回 十位, 个位

高, 低 = 分解(58)
打印(f"58 的十位={高} 个位={低}\n")

# 顶层全局多接收
x1, x2 = 计算(100)
打印(f"x1={x1} x2={x2}\n")
print("=== 多返回值测试完成 ===\n")