#// 测试：图形_背景图（控件/区域 PNG 背景，headless）
#// 覆盖 半透明PNG拉伸铺图 / 不透明RGB PNG / 文件缺失 / 非法文件 / 滚动容器内铺图
#// 验证返回码不崩溃；成功=1，失败(缺失/非PNG)=0

打印("GUI PNG背景测试开始\n")

r = 图形_初始化(320, 240, "PNG背景测试")
打印("初始化=")
打印(r)
打印("\n")

# 正常：拉伸（16x16->160x60）铺半透明红（alpha=200）
r = 图形_背景图(10, 10, 160, 60, "red.png")
打印("铺半透明红=")
打印(r)
打印("\n")

# 正常：不透明 RGB PNG（8x8->120x40 绿）
r = 图形_背景图(180, 10, 120, 40, "green.png")
打印("铺不透明绿=")
打印(r)
打印("\n")

# 文件缺失：应返回 0，不崩溃
r = 图形_背景图(10, 80, 50, 30, "不存在.png")
打印("缺失文件=")
打印(r)
打印("\n")

# 非法文件（非 PNG 内容的文本）：应返回 0，不崩溃
r = 图形_背景图(80, 80, 50, 30, "test_hello.vus")
打印("非法文件=")
打印(r)
打印("\n")

# 在滚动容器内铺图：验证裁剪语义不崩溃、返回 1
r = 图形_滚动容器("面板", 10, 130, 200, 80, 200)
打印("滚动容器登记=")
打印(r)
打印("\n")

r = 图形_背景图(10, 130, 200, 80, "green.png")
打印("容器内铺图=")
打印(r)
打印("\n")

r = 图形_滚动容器滚("面板", 40)
打印("容器滚动=")
打印(r)
打印("\n")

打印("GUI PNG背景测试结束\n")