#// 测试：GuiLite 控件+轮询交互（headless）
#// 覆盖 图形_初始化/图形_按钮/图形_取事件/图形_按钮点击
#// headless 下无真实点击，按钮点击检测应为 false；验证框架不崩溃、返回合理

打印("GUI控件测试开始\n")

r = 图形_初始化(200, 100, "控件测试")
打印("初始化=")
打印(r)
打印("\n")

# 创建两个按钮
r = 图形_按钮("开始", 10, 10, 80, 30, "开始")
打印("创建按钮1=")
打印(r)
打印("\n")

r = 图形_按钮("退出", 110, 10, 80, 30, "退出")
打印("创建按钮2=")
打印(r)
打印("\n")

# 轮询取事件（headless 下应返回 1，无点击）
r = 图形_取事件()
打印("取事件=")
打印(r)
打印("\n")

# 命中检测（headless 下未点击，应为 false）
r = 图形_按钮点击("开始")
打印("点击[开始]=")
打印(r)
打印("\n")

r = 图形_按钮点击("退出")
打印("点击[退出]=")
打印(r)
打印("\n")

# 用 if 直接判定（自然语言式条件入口）
如果 图形_按钮点击("开始"):
    打印("开始被点击\n")

# 自然语言别名：按钮被点击(名)
按钮状态 = 按钮被点击("退出")
打印("按钮被点击(退出)=")
打印(按钮状态)
打印("\n")

# 模拟点击 [开始] 按钮（10,10 80x30 内）
r = 图形_模拟点击(20, 20)
打印("模拟点击=")
打印(r)
打印("\n")

# 命中检测应返回 true
r = 图形_按钮点击("开始")
打印("点击[开始]后命中=")
打印(r)
打印("\n")

# 自然语言式 if：命中成立时应打印
将_命中 = 按钮被点击("开始")
如果 将_命中:
    打印("通过按钮被点击进入分支\n")

图形_刷新()
图形_保持()

打印("GUI控件测试结束\n")