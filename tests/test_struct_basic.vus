#// 测试：结构体基本定义和访问
#// 验证 struct 定义、创建和字段访问

#// 定义结构体
struct Point:
    x: int
    y: int

#// 创建结构体实例
p = Point(10, 20)

#// 访问字段
打印("p.x = ")
打印(p.x)
打印("\n")
打印("p.y = ")
打印(p.y)
打印("\n")

#// 创建第二个实例
p2 = Point(30, 40)
打印("p2.x = ")
打印(p2.x)
打印("\n")
打印("p2.y = ")
打印(p2.y)
打印("\n")

#// 结构体字段运算
面积 = p.x * p.y
打印("p.x * p.y = ")
打印(面积)
打印("\n")

打印("结构体基本测试完成\n")