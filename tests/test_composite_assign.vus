#// 复合赋值回归：+= -= *= /= %= ..= 展开为 a = a op b
打印("=== 复合赋值测试开始 ===\n")

n = 10
n += 5          #// 15
打印("n=")
打印(转文本(n))
打印("\n")
n -= 3          #// 12
n *= 2          #// 24
打印("n=")
打印(转文本(n))
打印("\n")
n /= 4          #// 6
打印("n=")
打印(转文本(n))
打印("\n")
n %= 4          #// 2
打印("n=")
打印(转文本(n))
打印("\n")

# 字符串拼接复合赋值 ..=
s = "你好"
s ..= "，世界"
打印("s=")
打印(s)
打印("\n")

# 在函数内局部变量也支持
定义 累加(x):
    x += 100
    返回 x
打印("累加(1)=")
打印(转文本(累加(1)))
打印("\n")

打印("=== 复合赋值测试结束 ===\n")