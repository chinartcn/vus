#// 测试：内建异常类型系统
#// 覆盖 抛出 [类型,] [消息] 与 捕获 <类型> 匹配

打印("=== 异常类型测试开始 ===\n")

#// 场景1：旧写法兼容 —— 抛出 "消息" + 捕获 消息（消息即类型）
定义 测试1():
    尝试:
        抛出 "超时错误"
        打印("不应打印: 抛出后\n")
    捕获 超时错误:
        打印("场景1: 旧写法按消息匹配 → 通过\n")

测试1()

#// 场景2：带类型抛出 + 按类型捕获
定义 测试2():
    尝试:
        抛出 值错误, "传参非法"
        打印("不应打印\n")
    捕获 值错误:
        打印("场景2: 按类型捕获 值错误 → 通过\n")
    捕获 网络错误:
        打印("场景2: 不应匹配 网络错误\n")

测试2()

#// 场景3：多分支按类型区分
定义 测试3():
    尝试:
        抛出 网络错误, "连接超时"
    捕获 值错误:
        打印("场景3: 错误匹配了 值错误 ✗\n")
    捕获 网络错误:
        打印("场景3: 多分支选中 网络错误 → 通过\n")

测试3()

#// 场景4：未匹配类型落到通配捕获
定义 测试4():
    尝试:
        抛出 文件错误, "文件不存在"
    捕获 值错误:
        打印("场景4: 错配 ✗\n")
    捕获:
        打印("场景4: 通配捕获兜底 → 通过\n")

测试4()

#// 场景5：单标识符抛出（旧行为消息里带类型名，捕获仍按消息命中）
定义 测试5():
    尝试:
        抛出 网络错误
    捕获 网络错误:
        打印("场景5: 单标识符抛出 + 同名捕获 → 通过\n")

测试5()

#// 场景6：类型/消息用表达式（类型=字符串表达式，消息=变量）
定义 测试6():
    消息 = "动态消息"
    尝试:
        抛出 "值错误", 消息
    捕获 值错误:
        打印("场景6: 表达式类型 + 动态消息 → 通过\n")

测试6()

#// 场景7：未捕获时恢复错误并冒泡（不崩溃）
定义 测试7():
    尝试:
        尝试:
            抛出 网络错误, "外层可见"
        捕获 文件错误:
            打印("场景7: 内层错配 ✗\n")
    捕获 网络错误:
        打印("场景7: 未捕获异常向上一级冒泡 → 通过\n")

测试7()

打印("=== 异常类型测试完成 ===\n")