#// 测试：控件库（headless，模拟点击）
#// 覆盖 标签/文本框/复选框/进度条/列表/列表行/列表选中/画布/画布命中/画布点
#// headless 下用 图形_模拟点击 注入坐标，验证命中与取值逻辑。

打印("控件库测试开始\n")

r = 图形_初始化(320, 220, "控件库测试")
打印("初始化=")
打印(r)
打印("\n")

# --- 基础控件 ---
r = 图形_标签("标题", 10, 10, "控件库演示", 0x0055AA)
打印("标签=")
打印(r)
打印("\n")

r = 图形_文本框("输入", 10, 30, 120, 24, "你好")
打印("文本框=")
打印(r)
打印("\n")

# 复选框：初始未勾选 -> false
勾选 = 图形_复选框("记住", 10, 62, "记住我", 0)
打印("复选框初始=")
打印(勾选)
打印("\n")

# 进度条
r = 图形_进度("进度", 10, 86, 150, 20, 45)
打印("进度条=")
打印(r)
打印("\n")

# --- 列表 ---
r = 图形_列表("菜单", 180, 10, 120, 90, 18)
打印("列表=")
打印(r)
打印("\n")
图形_列表行("菜单", 0, "0 选项")
图形_列表行("菜单", 1, "1 选项")
图形_列表行("菜单", 2, "2 选项")
打印("列表三行写入完成\n")

# 未点击时选中应为 -1
选中 = 图形_列表选中("菜单")
打印("选中(未点击)=")
打印(选中)
打印("\n")

# --- 画布 ---
r = 图形_画布("绘图区", 10, 120, 150, 80)
打印("画布=")
打印(r)
打印("\n")
# 在画布内画两条线
图形_画线(10, 120, 159, 199, 0xFF8800)
图形_画线(25, 140, 30, 60, 0x00CC00)

# ---------- 模拟点击系列 ----------
# 1) 点击复选框（10,62 方格区）-> 应切换为 true
图形_模拟点击(15, 68)
勾选 = 图形_复选框("记住", 10, 62, "记住我", 0)
打印("复选框点击后=")
打印(勾选)
打印("\n")

# 2) 点击列表第 2 行（180,10 起点，第2行 y=10+2*18=46）
图形_模拟点击(190, 50)
选中 = 图形_列表选中("菜单")
打印("选中(第2行)=")
打印(选中)
打印("\n")
行2 = 图形_列表行点击("菜单", 2)
打印("第2行命中=")
打印(行2)
打印("\n")

# 3) 点击画布内（相对坐标）
图形_模拟点击(60, 160)   # 画布起点(10,120)，相对 = (50,40)
r = 图形_画布命中("绘图区")
打印("画布命中=")
打印(r)
打印("\n")
点 = 图形_画布点("绘图区")
打印("画布相对点=")
打印(点)
打印("\n")

# 4) 点击画布外的点 -> 不应命中
图形_模拟点击(10, 10)
r = 图形_画布命中("绘图区")
打印("画布命中(区域外)=")
打印(r)
打印("\n")

图形_刷新()
图形_保持()

打印("控件库测试结束\n")