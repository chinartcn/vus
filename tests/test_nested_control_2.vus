#// 测试：复杂嵌套控制流
#// 验证 if/for/while 的深度嵌套

打印("=== 复杂嵌套控制流测试 ===\n")

#// 嵌套 if-else
a = 15
b = 25
如果 a > 10:
    如果 b > 20:
        如果 a + b > 30:
            打印("深度嵌套: 全部条件满足\n")

#// for 循环内嵌套 if-else
打印("3 的倍数或 5 的倍数: ")
循环 i 从 1 到 15:
    如果 i % 3 == 0:
        打印(i)
        打印(" ")
    否则如果 i % 5 == 0:
        打印(i)
        打印(" ")
打印("\n")

#// while 循环内嵌套 for
x = 1
当循环 x <= 3:
    打印("x=")
    打印(x)
    打印(": ")
    循环 j 从 1 到 x:
        打印(j)
        打印(" ")
    打印("\n")
    x = x + 1

打印("复杂嵌套控制流测试完成\n")