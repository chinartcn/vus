#// 测试：网络请求内建函数 (网络_*)
#// 覆盖 网络_GET/POST/下载
#// 注意：需要网络连接；若网络不可用，测试会输出失败但不会崩溃
打印("=== 网络测试开始 ===\n")

#// 1. 网络_GET —— 用 httpbin 的 get 接口测试
响应 = 网络_GET("https://httpbin.org/get")
打印("GET 响应长度: ")
如果 响应 != "":
    打印(对象文本(JSON_查询(JSON_解析(响应), "url")))
    打印("\n网络_GET: 通过\n")
否则:
    打印("(空响应，可能无网络)\n")
    打印("网络_GET: 跳过(无网络)\n")

#// 2. 网络_POST
响应2 = 网络_POST("https://httpbin.org/post", "key=hello")
打印("POST 响应长度: ")
如果 响应2 != "":
    打印(对象文本(JSON_查询(JSON_解析(响应2), "form.key")))
    打印("\n网络_POST: 通过\n")
否则:
    打印("(空响应)\n网络_POST: 跳过(无网络)\n")

打印("=== 网络测试完成 ===\n")