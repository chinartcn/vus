#// 测试：递归函数深度
#// 验证递归函数的正确性（阶乘 + 斐波那契）

定义 阶乘(n):
    如果 n <= 1:
        返回 1
    返回 n * 阶乘(n - 1)

定义 斐波那契(n):
    如果 n <= 1:
        返回 n
    返回 斐波那契(n - 1) + 斐波那契(n - 2)

打印("=== 递归测试 ===\n")

打印("5! = ")
打印(阶乘(5))
打印("\n")

打印("10! = ")
打印(阶乘(10))
打印("\n")

打印("fib(10) = ")
打印(斐波那契(10))
打印("\n")

打印("fib(15) = ")
打印(斐波那契(15))
打印("\n")

打印("递归测试完成\n")