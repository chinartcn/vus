#// 测试：终端 UI 内建函数 (tui_*)
#// 覆盖 旧流式 5 函数 + 画布模型（绘制/边框/差分刷新）+ 终端查询 + 输入安全
打印("=== TUI 测试开始 ===\n")

#// ---- 1. 旧流式函数（验证调用不崩溃；参数钳制后越界值不再喷垃圾序列）----
tui_清屏()
打印("tui_清屏: 通过\n")

tui_设置颜色(196, 0)
打印("红色文字测试\n")
打印("tui_设置颜色: 通过\n")

tui_定位(3, 1)
打印("tui_定位(3,1): 通过\n")

tui_进度条(50, 100, 30)
打印("\ntui_进度条: 通过\n")

tui_重置()
打印("tui_重置: 通过\n")

#// 越界钳制：色号 9999 应被钳到 255，不输出非法序列（无 TTY 时本就静默）
tui_设置颜色(9999, -3)
tui_重置()

#// ---- 2. 画布模型：帧缓冲 + 差分刷新 + 边框 ----
tui_画布(12, 40)
tui_绘制文本(1, 2, "画布测试", 46, -1, 1)     # 前景46(青) 默认背景 加粗
tui_绘制文本(2, 2, "普通文本")
tui_边框(3, 1, 5, 30, "窗口标题")
tui_刷新()
打印("tui_画布/绘制文本/边框/刷新: 通过\n")

#// 差分：同一帧再次刷新应零输出（无 TTY 静默）
tui_刷新()
打印("tui_刷新(幂等): 通过\n")

#// 清行（画布 + 终端）
tui_清行(2)
tui_刷新()
打印("tui_清行: 通过\n")

#// 光标显隐 + 流式样式
tui_光标(0)
tui_光标(1)
tui_文本样式(1)   # 加粗
tui_文本样式(0)   # 复位
打印("tui_光标/文本样式: 通过\n")

#// ---- 3. 终端查询与输入（无终端环境：尺寸回退 24,80；读取/输入返回空串）----
尺寸 = tui_终端尺寸()
打印("tui_终端尺寸: ")
打印(尺寸)
打印("\n")
断言(长度(尺寸) > 0, "终端尺寸非空")
断言(尺寸 == "24,80", "无终端回退 24x80")

键 = tui_读取按键()
断言(键 == "", "无终端读取按键返回空")

输入 = tui_输入文本("输入: ", 20)
断言(输入 == "", "无终端输入文本返回空")

打印("=== TUI 测试完成 ===\n")
