#// 测试：终端 UI 内建函数 (tui_*)
#// 覆盖 tui_清屏/重置/设置颜色/定位/进度条
打印("=== TUI 测试开始 ===\n")

# 注意：tui_* 在 Termux 中才有效；在普通终端也会输出 ANSI 序列
# 这里只验证函数调用不崩溃

#// 1. tui_清屏
tui_清屏()
打印("tui_清屏: 通过\n")

#// 2. tui_设置颜色
tui_设置颜色(196, 0)
打印("红色文字测试\n")
打印("tui_设置颜色: 通过\n")

#// 3. tui_定位
tui_定位(3, 1)
打印("tui_定位(3,1): 通过\n")

#// 4. tui_进度条
tui_进度条(50, 100, 30)
打印("\ntui_进度条: 通过\n")

#// 5. tui_重置
tui_重置()
打印("tui_重置: 通过\n")

打印("=== TUI 测试完成 ===\n")