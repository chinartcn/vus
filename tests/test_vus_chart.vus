#// test_vus_chart.vus — 测试图表渲染/谱面生成
#// 覆盖 vus_chart_main 函数

打印("=== VUS 图表谱面生成测试 ===\n")

#// 测试1：使用 beat_test.wav 生成谱面
打印("测试1: 从 WAV 生成谱面\n")
图表输出 = 命令_执行("./vus chart examples/beat_test.wav -o /tmp/test_chart_out.json 2>&1")
打印(图表输出)
打印("---\n")

#// 验证输出的 chart.json 文件存在
存在JSON = 文件_存在("/tmp/test_chart_out.json")
如果 存在JSON == "true":
    打印("谱面文件生成成功: /tmp/test_chart_out.json\n")
否则:
    打印("失败: 谱面文件未生成\n")
    打印("谱面测试失败: JSON文件未生成\n")

#// 测试2：读取并验证生成的 chart.json 内容
打印("测试2: 验证谱面 JSON 内容\n")
图表内容 = 文件_读取("/tmp/test_chart_out.json")
打印("谱面内容: ")
打印(图表内容)
打印("\n---\n")

#// 测试3：解析并验证 JSON 结构
打印("测试3: 解析验证谱面 JSON\n")
图表数据 = JSON_解析(图表内容)
标题 = JSON_查询(图表数据, "title")
打印("标题: ")
打印(标题)
打印("\n")

音符数 = JSON_查询(图表数据, "note_count")
打印("音符数: ")
打印(音符数)
打印("\n")

#// 验证关键字段存在
如果 标题 != "":
    打印("谱面标题字段正常\n")
否则:
    打印("警告: 谱面标题为空\n")

#// 测试4：使用已存在的 chart.json 验证格式
打印("测试4: 验证已有谱面格式\n")
已有图表 = 文件_读取("examples/beat_test.chart.json")
打印("已有谱面内容前100字符: ")
打印(对象文本(已有图表))
打印("\n---\n")

#// 测试5：错误处理 — 无效音频文件
打印("测试5: 错误处理 — 无效音频文件\n")
错误输出 = 命令_执行("./vus chart /tmp/不存在的音频.wav -o /tmp/test_err.json 2>&1")
打印(错误输出)
打印("---\n")

#// 清理临时文件
文件_删除("/tmp/test_chart_out.json")

打印("=== 图表谱面测试完成 ===\n")