#// 测试：模运算（%）和复合运算
#// 验证取模运算符和各类复合表达式

打印("=== 模运算测试 ===\n")

#// 基本模运算
a = 10 % 3
打印("10 % 3 = ")
打印(a)
打印("\n")

b = 20 % 7
打印("20 % 7 = ")
打印(b)
打印("\n")

#// 模运算与循环结合
打印("1 到 20 中能被 3 整除的数: ")
循环 i 从 1 到 20:
    如果 i % 3 == 0:
        打印(i)
        打印(" ")
打印("\n")

#// 复合表达式
c = (10 + 5) * 2 - 3
打印("(10+5)*2-3 = ")
打印(c)
打印("\n")

#// 优先级测试：乘法优先于加法
d = 2 + 3 * 4
打印("2 + 3 * 4 = ")
打印(d)
打印("\n")

#// 优先级测试：括号改变优先级
e = (2 + 3) * 4
打印("(2 + 3) * 4 = ")
打印(e)
打印("\n")

打印("模运算测试完成\n")