#// 测试：取反运算符 ! 和逻辑非
#// 验证取反运算符在不同场景下的行为

打印("=== 取反运算符测试 ===\n")

#// 取反 0（真值）
打印("!0 = ")
打印(!0)
打印("\n")

#// 取反 1（真值）
打印("!1 = ")
打印(!1)
打印("\n")

#// 取反非零值
打印("!42 = ")
打印(!42)
打印("\n")

#// 取反取反（双重否定）
打印("!!1 = ")
打印(!!1)
打印("\n")

#// 取反在条件中使用
x = 0
如果 !x:
    打印("x 为假（0），取反后为真\n")

y = 10
如果 !y:
    打印("不应打印\n")
否则:
    打印("y 为真（非零），取反后为假\n")

#// 取反与比较组合
a = 5
b = 10
如果 !(a > b):
    打印("a 不大于 b，取反后为真\n")

打印("取反运算符测试完成\n")