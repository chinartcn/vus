# 测试线程和协程语法解析

# 全局变量声明（线程句柄、协程句柄）
t = ""
c = ""

# 定义一个简单的函数
定义 线程测试(参数):
    打印("线程运行中，参数：" + 参数)


# 测试线程创建和等待
定义 主线程测试():
    打印("=== 线程测试 ===\n")
    
    # 创建线程
    t = 线程(线程测试, "你好")
    
    # 等待线程完成
    等待线程(t)
    
    打印("=== 线程测试完成 ===\n")


# 测试协程
定义 协程函数(参数):
    打印("协程运行中，参数：" + 参数)
    让出()
    打印("协程继续运行\n")


定义 主协程测试():
    打印("=== 协程测试 ===\n")
    
    # 创建协程
    c = 协程(协程函数, "世界")
    
    # 恢复协程
    恢复(c)
    
    打印("=== 协程测试完成 ===\n")


# 主程序
主线程测试()
主协程测试()