# 网页服务 + 三引号多行字符串测试
# 用法: vus run tests/test_web.vus
#   脚本启动两个 HTTP 服务并睡眠保持存活，期间用浏览器/curl 访问：
#     内容模式 http://127.0.0.1:8080/   目录模式 http://127.0.0.1:8082/

# ---- 1) 三引号多行字符串（跨行 + {表达式} 插值） ----
标题 = "VUS 网页服务"
页面 = """
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>{标题}</title></head>
<body>
<h1>{标题}</h1>
<p>这段页面由三引号多行字符串与插值构建。</p>
</body>
</html>
"""
打印("三引号长度: " .. 文本_长度(页面) .. "\n")
断言(正则_查找(页面, "VUS 网页服务") == "1", "三引号插值生效")
断言(正则_查找(页面, "<!DOCTYPE html>") == "1", "三引号保留跨行结构")

# ---- 2) 内容模式：把 HTML 内容直接作为网页 ----
网址 = 网页_服务("8080", 页面)
打印("内容服务: " .. 网址 .. "\n")
断言(正则_查找(网址, "127.0.0.1:8080") == "1", "内容模式启动成功")

# ---- 3) 目录模式：静态文件服务，入口/端口取自 webroot/网页.json ----
网址2 = 网页_服务目录("tests/webroot", "")
打印("目录服务: " .. 网址2 .. "\n")
断言(正则_查找(网址2, "127.0.0.1:8082") == "1", "目录模式读取配置端口 8082")

# ---- 4) 端口冲突 ----
占用 = 网页_服务("8080", "<h1>x</h1>")
打印("端口冲突: " .. 占用 .. "\n")
断言(正则_查找(占用, "端口已被占用") == "1", "重复端口被拒绝")

# 保持进程存活：期间外部可访问两个服务（自动回归时可改小），最后优雅停止
睡眠(5000)

打印("停止内容服务: " .. 网页_停止("8080") .. "\n")
打印("停止目录服务: " .. 网页_停止("8082") .. "\n")
打印("重复停止: " .. 网页_停止("8080") .. "\n")