#// VUS 语言综合功能演示
#// 展示：变量 · 算术运算 · 字符串拼接 · 比较运算符
#//      条件分支 · 循环 · 函数 · 递归 · 嵌套循环

#// ==================== 函数定义 ====================

#// 阶乘（递归函数）
定义 阶乘(n):
    如果 n <= 1:
        返回 1
    返回 n * 阶乘(n - 1)

#// 斐波那契（双递归函数）
定义 斐波那契(n):
    如果 n <= 1:
        返回 n
    返回 斐波那契(n - 1) + 斐波那契(n - 2)

#// 判断质数（返回 "true" 或 "false"）
定义 是质数(n):
    如果 n < 2:
        返回 0 == 0  # 返回 "true"
    循环 i 从 2 到 n - 1:
        如果 n % i == 0:
            返回 0 == 1  # 返回 "false"
    返回 0 == 0  # 返回 "true"

#// 计算范围内质数个数（递归）
定义 质数个数(limit):
    如果 limit < 2:
        返回 0
    如果 是质数(limit):
        返回 1 + 质数个数(limit - 1)
    返回 质数个数(limit - 1)

#// ==================== 主程序 ====================

打印("╔══════════════════════════════════════╗\n")
打印("║       VUS 语言 v0.1 综合功能演示      ║\n")
打印("╚══════════════════════════════════════╝\n\n")

#// ── 1. 变量与赋值 ──
打印("┌── 1. 变量与赋值 ──────────────────┐\n")
打印("│\n")

姓名 = "小明"
年龄 = 25
身高 = 175
打印("│ 姓名: ")
打印(姓名)
打印("\n")
打印("│ 年龄: ")
打印(年龄)
打印("\n")
打印("│ 身高: ")
打印(身高)
打印("\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 2. 四则运算 ──
打印("┌── 2. 四则运算 ────────────────────┐\n")
打印("│\n")

a = 100
b = 7
打印("│ a = 100, b = 7\n")
打印("│ a + b = ")
打印(a + b)
打印("\n")
打印("│ a - b = ")
打印(a - b)
打印("\n")
打印("│ a * b = ")
打印(a * b)
打印("\n")
打印("│ a / b = ")
打印(a / b)
打印("\n")
打印("│ a % b = ")
打印(a % b)
打印("\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 3. 字符串拼接 ──
打印("┌── 3. 字符串拼接 ──────────────────┐\n")
打印("│\n")

问候 = "你好"
名字 = "世界"
打印("│ ")
打印(问候 + "，" + 名字 + "！\n")
打印("│\n")

#// 混合拼接（字符串 + 数字）
打印("│ 姓名: " + 姓名 + "，年龄: " + 年龄 + "\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 4. 比较运算符 ──
打印("┌── 4. 比较运算符 ──────────────────┐\n")
打印("│\n")

x = 10
y = 20
打印("│ x = 10, y = 20\n")
打印("│\n")
如果 x < y:
    打印("│ x < y  成立\n")
如果 x <= y:
    打印("│ x <= y 成立\n")
如果 x != y:
    打印("│ x != y 成立\n")
如果 y > x:
    打印("│ y > x  成立\n")
如果 y >= x:
    打印("│ y >= x 成立\n")
如果 x == x:
    打印("│ x == x 成立\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 5. 条件分支（如果/否则）──
打印("┌── 5. 条件分支 ────────────────────┐\n")
打印("│\n")

分数 = 85
打印("│ 分数: ")
打印(分数)
打印("\n")
如果 分数 >= 90:
    打印("│ 等级: 优秀\n")
否则如果 分数 >= 80:
    打印("│ 等级: 良好\n")
否则如果 分数 >= 60:
    打印("│ 等级: 及格\n")
否则:
    打印("│ 等级: 不及格\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 6. 循环（范围循环）──
打印("┌── 6. 范围循环 ────────────────────┐\n")
打印("│\n")
打印("│ 1 到 10 的偶数: ")
循环 i 从 1 到 10:
    如果 i % 2 == 0:
        打印(i)
        打印(" ")
打印("\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 7. 当循环 ──
打印("┌── 7. 当循环 ──────────────────────┐\n")
打印("│\n")
打印("│ 2 的幂不超过 100: ")
幂 = 1
当循环 幂 <= 100:
    打印(幂)
    打印(" ")
    幂 = 幂 * 2
打印("\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 8. 嵌套循环（乘法表）──
打印("┌── 8. 嵌套循环（乘法表）───────────┐\n")
打印("│\n")
循环 i 从 1 到 9:
    打印("│   ")
    循环 j 从 1 到 i:
        打印(i * j)
        打印(" ")
    打印("\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 9. 递归函数 ──
打印("┌── 9. 递归函数 ────────────────────┐\n")
打印("│\n")

打印("│ 1! 到 10!:\n")
打印("│ ")
循环 i 从 1 到 10:
    打印(i)
    打印("!=")
    打印(阶乘(i))
    打印(" ")
打印("\n")
打印("│\n")

打印("│ 斐波那契数列前 15 项:\n")
打印("│ ")
循环 i 从 0 到 14:
    打印(斐波那契(i))
    打印(" ")
打印("\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 10. 综合应用 ──
打印("┌── 10. 综合应用 ───────────────────┐\n")
打印("│\n")

打印("│ 2 到 100 之间的质数:\n")
打印("│ ")
循环 i 从 2 到 100:
    如果 是质数(i):
        打印(i)
        打印(" ")
打印("\n")
打印("│\n")

打印("│ 2 到 100 之间质数个数: ")
打印(质数个数(100))
打印("\n")
打印("│\n")

打印("│ 1 到 100 的和 = ")
合计 = 0
循环 i 从 1 到 100:
    合计 = 合计 + i
打印(合计)
打印("\n")
打印("│\n")

打印("│ 1! + 2! + ... + 10! = ")
总和 = 0
循环 i 从 1 到 10:
    总和 = 总和 + 阶乘(i)
打印(总和)
打印("\n")
打印("│\n")
打印("└───────────────────────────────────┘\n\n")

#// ── 结束 ──
打印("╔══════════════════════════════════════╗\n")
打印("║       演示结束，全部功能正常！       ║\n")
打印("╚══════════════════════════════════════╝\n")