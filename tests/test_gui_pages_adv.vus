#// 测试：多页导航进阶（真实绘制 / 事件驱动翻页 / 深层栈 / 去重回跳 / 多外部页面 + 级联导入）
#// headless 全流程：不进入真实事件循环，用 图形_模拟点击 注入点击触发 事件_点击 回调驱动翻页。
#// 覆盖：
#//   1. 真实绘制：页_首页 内调用 图形_画线 / 图形_填充矩形，绘制触发页函数体（打印标记）
#//   2. 事件驱动翻页：事件_点击 回调 + 图形_模拟点击 实现按坐标点击切换页面
#//   3. 深层栈：打开 A→B→C→D，逐步 返回 弹栈，打印每步当前页断言顺序
#//   4. 去重回跳：打开已存在的中间页，弹出其上所有层回到该页
#//   5. 多外部页面 + 级联导入：import 两个外部模块，其中一个再嵌套 import 子模块，页函数均可绘制

打印("多页导航进阶测试开始\n")

# 接入两个不同的外部页面模块（各自定义 页_<名>）；pages_mod_b 内部又嵌套导入 pages_sub_a
导入 pages_mod_a
导入 pages_mod_b

r = 图形_初始化(320, 240, "多页导航进阶测试")
打印("初始化=")
打印(r)
打印("\n")

# =====================================================================
# 约定式页函数（本脚本内定义）
# =====================================================================

# 首页：真实绘制——页函数体内调用两个真实图形 API，并在开头打印标记以便观察是否被触发
定义 页_首页():
    打印("首页_真实绘制_触发\n")
    r1 = 图形_画线(10, 10, 300, 200, 0xFF0000)
    打印("首页画线=")
    打印(r1)
    打印("\n")
    r2 = 图形_填充(40, 40, 100, 60, 0x0000FF)
    打印("首页填充=")
    打印(r2)
    打印("\n")

定义 页_设置():
    打印("设置页_绘制_触发\n")

# =====================================================================
# 事件回调：headless 下由 图形_模拟点击 注入坐标触发（非阻塞，不进入事件循环）
# 命中「下一页→」按钮中心点 (180,150) 时翻开「设置」页。
# 说明：完整矩形区域命中需数值坐标判断，但当前版本 generator 对「转数字」
#       赋值/比较路径存在 OOB（把 int64 当 VusString* ref），会崩溃；故用坐标
#       点字符串精确匹配作命中判定（事件带入的 x/y 即为点击坐标字符串）。
# =====================================================================
定义 事件_点击(x, y):
    打印("事件_点击回调触发 x=")
    打印(x)
    打印(" y=")
    打印(y)
    打印("\n")
    如果 x == "180" 和 y == "150":
        ev = 图形_页面_打开("设置")
        打印("回调中打开设置=")
        打印(ev)
        打印("\n")

# =====================================================================
# 场景 1：真实绘制 —— 打开首页并绘制，应触发 页_首页 体（打印标记 + 图形 API 成功）
# =====================================================================
r = 图形_页面_打开("首页")
打印("打开首页=")
打印(r)
打印("\n")
cur = 图形_页面_当前()
打印("当前页=")
打印(cur)
打印("\n")
d = 图形_页面_绘制()
打印("绘制首页=")
打印(d)
打印("\n")
如果 cur == "首页" 和 d == "1":
    打印("场景1真实绘制：通过\n")
否则:
    打印("场景1真实绘制：失败\n")

# 页_首页 体内的 图形_画线 / 图形_填充矩形 返回值会随上面绘制打出；
# 只要上面出现「首页_真实绘制_触发」标记且「首页画线=1」「首页填充矩形=1」即证明页体被触发且图形 API 在 headless 可用。

# =====================================================================
# 场景 2：事件驱动翻页 —— 模拟点击「下一页」命中回调区域，事件回调打开设置页
# =====================================================================
sc = 图形_模拟点击(180, 150)
打印("模拟点击=")
打印(sc)
打印("\n")
cur = 图形_页面_当前()
打印("点击后当前页=")
打印(cur)
打印("\n")
如果 cur == "设置":
    打印("场景2事件驱动翻页：通过\n")
否则:
    打印("场景2事件驱动翻页：失败\n")

# =====================================================================
# 场景 3：深层栈 —— 在设置页基础上继续压栈 仪表盘→关于→子页，再逐步返回
# =====================================================================
r = 图形_页面_打开("仪表盘")
cur = 图形_页面_当前()
打印("打开仪表盘后当前=")
打印(cur)
打印("\n")
r = 图形_页面_打开("关于")
cur = 图形_页面_当前()
打印("打开关于后当前=")
打印(cur)
打印("\n")
r = 图形_页面_打开("子页")
cur = 图形_页面_当前()
打印("打开子页后当前=")
打印(cur)
打印("\n")

如果 cur == "子页":
    打印("场景3压栈(到最深层)：通过\n")
否则:
    打印("场景3压栈(到最深层)：失败\n")

# 逐步返回：子页→关于→仪表盘
r = 图形_页面_返回()
cur = 图形_页面_当前()
打印("返回1当前=")
打印(cur)
打印("\n")
如果 cur == "关于":
    打印("场景3返回1：通过\n")
否则:
    打印("场景3返回1：失败\n")

r = 图形_页面_返回()
cur = 图形_页面_当前()
打印("返回2当前=")
打印(cur)
打印("\n")
如果 cur == "仪表盘":
    打印("场景3返回2：通过\n")
否则:
    打印("场景3返回2：失败\n")

r = 图形_页面_返回()
cur = 图形_页面_当前()
打印("返回3当前=")
打印(cur)
打印("\n")
如果 cur == "设置":
    打印("场景3返回3：通过\n")
否则:
    打印("场景3返回3：失败\n")

# =====================================================================
# 场景 4：去重回跳 —— 构造 A→B→C→A，打开已存在的首页应弹掉其上所有层回到首页
# 此时栈为 [首页, 设置]，当前在「设置」，依次压入 仪表盘、关于 后打开 首页
# =====================================================================
r = 图形_页面_打开("仪表盘")
r = 图形_页面_打开("关于")
r = 图形_页面_打开("首页")
cur = 图形_页面_当前()
打印("去重回跳后当前=")
打印(cur)
打印("\n")
如果 cur == "首页":
    打印("场景4去重回跳：通过\n")
否则:
    打印("场景4去重回跳：失败\n")

# 栈现应为 [首页]，在栈底再返回应失败（返回 "0"）
r = 图形_页面_返回()
打印("栈底返回应失败=")
打印(r)
打印("\n")
如果 r == "0":
    打印("场景4栈底返回保护：通过\n")
否则:
    打印("场景4栈底返回保护：失败\n")

# =====================================================================
# 场景 5：多外部页面 + 级联导入 —— 分别绘制 外部A(仪表盘)/外部B(关于)/层级子模块(子页)
# 每个 图形_页面_绘制 都应在 dlsym 找到对应 页_<名> 并调用（返回 "1"）
# =====================================================================
r = 图形_页面_打开("仪表盘")
cur = 图形_页面_当前()
d = 图形_页面_绘制()
打印("绘制外部A仪表盘 当前=")
打印(cur)
打印(" 绘制=")
打印(d)
打印("\n")
如果 d == "1":
    打印("场景5外部模块A页绘制：通过\n")
否则:
    打印("场景5外部模块A页绘制：失败\n")

# 去重后打开 关于 会弹回之前栈，回到当前页为 关于
r = 图形_页面_打开("关于")
cur = 图形_页面_当前()
d = 图形_页面_绘制()
打印("绘制外部B关于页 当前=")
打印(cur)
打印(" 绘制=")
打印(d)
打印("\n")
如果 d == "1":
    打印("场景5外部模块B页绘制：通过\n")
否则:
    打印("场景5外部模块B页绘制：失败\n")

# 子页来自 pages_mod_b 嵌套导入的 pages_sub_a（级联 import 的最内层符号）
r = 图形_页面_打开("子页")
cur = 图形_页面_当前()
d = 图形_页面_绘制()
打印("绘制嵌套子页 当前=")
打印(cur)
打印(" 绘制=")
打印(d)
打印("\n")
如果 d == "1":
    打印("场景5级联嵌套页绘制：通过\n")
否则:
    打印("场景5级联嵌套页绘制：失败\n")

打印("多页导航进阶测试结束\n")