#// 测试：负数、一元负号运算符
#// 验证负数的解析和运算

打印("=== 负数测试 ===\n")

#// 测试负数赋值
a = -5
b = -10

#// 打印负数
打印("a = ")
打印(a)
打印("\n")
打印("b = ")
打印(b)
打印("\n")

#// 测试负数加法
c = a + b
打印("a + b = ")
打印(c)
打印("\n")

#// 测试负数减法
d = a - b
打印("a - b = ")
打印(d)
打印("\n")

#// 测试负数乘法
e = a * 2
打印("a * 2 = ")
打印(e)
打印("\n")

#// 测试复杂表达式中的负数
f = -3 + 10
打印("-3 + 10 = ")
打印(f)
打印("\n")

#// 测试取反后的变量
g = -a
打印("-a = ")
打印(g)
打印("\n")

打印("负数测试完成\n")