#// 测试：字符串拼接运算符（++）
#// 验证 ++ 运算符用于字符串拼接

打印("=== 字符串拼接测试 ===\n")

#// 基本拼接
a = "hello" + " world"
打印("基本拼接: ")
打印(a)
打印("\n")

#// 多级拼接
b = "a" + "b" + "c" + "d"
打印("多级拼接: ")
打印(b)
打印("\n")

#// 变量拼接
姓名 = "李四"
年龄 = 30
打印("姓名: " + 姓名 + "，年龄: " + 转文本(年龄) + "\n")

#// 空字符串拼接
打印("空字符串测试: ")
打印("" + "非空")
打印("\n")

#// 拼接后比较
如果 "abc" + "def" == "abcdef":
    打印("拼接后比较正确\n")

打印("字符串拼接测试完成\n")