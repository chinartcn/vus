#// 测试：多页导航（页面栈 + 外部 .vus 页面 import），headless
#// 覆盖 图形_页面_打开/返回/当前/绘制 与「导入 外部页面模块」

打印("多页导航测试开始\n")

# 接入外部 .vus 页面（提供 页_关于）
导入 test_pages_ext

r = 图形_初始化(320, 240, "多页导航测试")
打印("初始化=")
打印(r)
打印("\n")

# 约定式页函数
定义 页_首页():
    打印("首页绘制\n")

定义 页_设置():
    打印("设置页绘制\n")

# 打开首页
r = 图形_页面_打开("首页")
打印("打开首页=")
打印(r)
打印("\n")

cur = 图形_页面_当前()
打印("当前页=")
打印(cur)
打印("\n")

d = 图形_页面_绘制()
打印("绘制首页=")
打印(d)
打印("\n")

# 再打开设置页（压栈）
r = 图形_页面_打开("设置")
cur = 图形_页面_当前()
打印("打开设置后当前=")
打印(cur)
打印("\n")

# 打开已存在的首页：应弹出上方层回到首页（去重）
r = 图形_页面_打开("首页")
cur = 图形_页面_当前()
打印("去重后当前=")
打印(cur)
打印("\n")

# 打开外部 .vus 页面（页_关于 来自 test_pages_ext.vus）
r = 图形_页面_打开("关于")
cur = 图形_页面_当前()
打印("外部页当前=")
打印(cur)
打印("\n")

d = 图形_页面_绘制()
打印("绘制外部页=")
打印(d)
打印("\n")

# 返回：应弹回首页
r = 图形_页面_返回()
cur = 图形_页面_当前()
打印("返回后当前=")
打印(cur)
打印("\n")

# 在首页返回应失败（已在栈底）
r = 图形_页面_返回()
打印("栈底返回=")
打印(r)
打印("\n")

打印("多页导航测试结束\n")