#// JSON 与字典键遍历端到端测试（yyjson 纯 C 实现，不依赖 Python）
打印("=== JSON 测试开始 ===\n")

#// 1. JSON_解析：解析嵌套对象
对象 = JSON_解析("{\"name\":\"小明\",\"age\":18,\"tags\":[\"a\",\"b\"]}")
打印("解析类型: ")
打印(typeof(对象))
打印("\n解析后生成: ")
打印(JSON_生成(对象))
打印("\n")

#// 2. JSON_查询：路径取值
打印("查询 name: ")
打印(JSON_查询("{\"user\":{\"name\":\"张三\"}}", "user.name"))
打印("\n查询 tags[1]: ")
打印(JSON_查询("{\"tags\":[\"a\",\"b\"]}", "tags[1]"))
打印("\n")

#// 3. JSON_生成：标量/列表序列化
打印("列表生成: ")
打印(JSON_生成(JSON_解析("[1, \"x\", {\"k\": true}]")))
打印("\n")

#// 4. 字典_键 + foreach：遍历字典键
键列表 = 字典_键(JSON_解析("{\"x\":1,\"y\":2,\"z\":3}"))
打印("字典键: ")
for 键 in 键列表:
    打印(键)
    打印(" ")
打印("\n")

打印("=== JSON 测试完成 ===\n")