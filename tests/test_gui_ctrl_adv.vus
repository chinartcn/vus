#// 测试：高级交互控件（滑块/开关/微调/单选，headless）
#// 绘制后不点击，用 图形_*值 读回当前值并打印。
#// 覆盖 默认/缺省参数、越界值、步长、多选项单选。

打印("高级控件测试开始\n")

r = 图形_初始化(320, 240, "高级控件测试")
打印("初始化=")
打印(r)
打印("\n")

# --- 滑块：默认 min=0 max=100 ---
v = 图形_滑块("音量", 10, 10, 200, 50)
打印("滑块绘制返回=")
打印(v)
打印("\n")

v = 图形_滑块值("音量")
打印("滑块值=")
打印(v)
打印("\n")

# --- 滑块：显式 min/max 且 value 越上界，应被钳制到 max ---
v = 图形_滑块("速度", 10, 34, 200, 999, 0, 300)
打印("滑块(minmax)=")
打印(v)
打印("\n")

v = 图形_滑块值("速度")
打印("滑块值2=")
打印(v)
打印("\n")

# --- 开关：默认关 ---
s = 图形_开关("开关1", 10, 60)
打印("开关默认=")
打印(s)
打印("\n")

s = 图形_开关值("开关1")
打印("开关值=")
打印(s)
打印("\n")

# --- 开关：初始开 ---
s = 图形_开关("开关2", 10, 90, 1)
打印("开关初始开=")
打印(s)
打印("\n")

s = 图形_开关值("开关2")
打印("开关值2=")
打印(s)
打印("\n")

# --- 微调：默认步长 1 ---
n = 图形_微调("数值", 10, 120, 5)
打印("微调返回=")
打印(n)
打印("\n")

n = 图形_微调值("数值")
打印("微调值=")
打印(n)
打印("\n")

# --- 微调：步长 5 ---
n = 图形_微调("温度", 10, 150, 20, 5)
打印("微调(步5)=")
打印(n)
打印("\n")

n = 图形_微调值("温度")
打印("微调值2=")
打印(n)
打印("\n")

# --- 单选：默认选中第 1 项 ---
r = 图形_单选("性别", 10, 180, 24, "男;女;保密", 1)
打印("单选返回=")
打印(r)
打印("\n")

r = 图形_单选值("性别")
打印("单选值=")
打印(r)
打印("\n")

# --- 单选：默认选中第 0 项 ---
r = 图形_单选("系统", 180, 180, 22, "Linux;Windows;MacOS", 0)
打印("单选2返回=")
打印(r)
打印("\n")

r = 图形_单选值("系统")
打印("单选值2=")
打印(r)
打印("\n")

图形_刷新()
打印("高级控件测试结束\n")