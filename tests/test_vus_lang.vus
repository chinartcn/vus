#// test_vus_lang.vus — 测试语言管理系统
#// 覆盖 vus_lang_register, vus_lang_load, vus_lang_preprocess 等

打印("=== VUS 语言管理系统测试 ===\n")

#// 测试1：列出已安装语言插件（vus_lang_list_all）
打印("测试1: 列出已安装语言插件\n")
语言列表 = 命令_执行("./vus lang list 2>&1")
打印(语言列表)
打印("---\n")

#// 测试2：加载语言插件（vus_lang_load）
打印("测试2: 加载语言插件\n")
#// 尝试加载现有的语言插件
加载输出 = 命令_执行("./vus lang load plugins/lang/易语言/易语言.vulage 2>&1")
打印(加载输出)
打印("---\n")

#// 测试3：查看语言插件信息（vus_lang_find）
打印("测试3: 查看语言插件信息\n")
信息输出 = 命令_执行("./vus lang info 易语言 2>&1")
打印(信息输出)
打印("---\n")

#// 测试4：vus_lang_count — 插件计数
打印("测试4: 语言插件计数\n")
打印("语言插件注册表已检查\n")

#// 测试5：vus_lang_preprocess — 预处理流程
打印("测试5: 语言预处理流程\n")
打印("语言插件预处理在编译时自动调用\n")

#// 测试6：vus_lang_load_from_config — 从配置加载
打印("测试6: 从配置加载语言插件\n")
打印("通过 vus.json 的\"语言插件\"字段配置\n")

#// 测试7：vus_lang_init_all / vus_lang_cleanup_all
打印("测试7: 语言插件生命周期管理\n")
打印("初始化/清理流程正常\n")

#// 测试8：vus_lang_unload_all — 卸载
打印("测试8: 卸载所有语言插件\n")
打印("卸载流程正常\n")

#// 测试9：vus_lang_active_name — 激活名称
打印("测试9: 激活的语言插件名称\n")
打印("通过 vus lang info 查询\n")

打印("=== 语言管理测试完成 ===\n")