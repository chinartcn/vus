#// 函数一等公民测试：函数值装箱 + 通过函数值调用
定义 加乘(x, y):
    返回 x + y

定义 二次方(n):
    返回 n * n

# 把函数作为值取出
f1 = 函数值(加乘)
f2 = 函数值(二次方)

r1 = 调用(f1, 3, 4)
打印(f"调用(加乘, 3, 4) = {r1}\n")

r2 = 调用(f2, 6)
打印(f"调用(二次方, 6) = {r2}\n")

# 函数值可像普通值一样在列表里存
函数集 = [函数值(加乘), 函数值(二次方)]
r3 = 调用(函数集[0], 10, 20)
打印(f"列表里的函数值调用 = {r3}\n")
print("=== 函数一等公民测试完成 ===\n")