#// 测试：GuiLite 绘图基础层（图形_* 内建函数）
#// 覆盖 图形_初始化/画点/画线/矩形/填充/文字/刷新/保持
#// 验证：初始化成功、各绘制调用返回成功、刷新后生成 PPM 便于像素断言

打印("GUI测试开始\n")

# 初始化 100x100 窗口
init_r = 图形_初始化(100, 100, "VUS GuiLite 测试")
打印("初始化=")
打印(init_r)
打印("\n")

# 整屏填充白色背景
r = 图形_填充(0, 0, 100, 100, 0xFFFFFF)
打印("背景填充=")
打印(r)
打印("\n")

# 画点（红色）
r = 图形_画点(10, 10, 0xFF0000)
打印("画点=")
打印(r)
打印("\n")

# 画线（绿色）
r = 图形_画线(20, 20, 50, 20, 0x00FF00)
打印("画线=")
打印(r)
打印("\n")

# 空心矩形（蓝色）
r = 图形_矩形(30, 30, 20, 20, 0x0000FF)
打印("矩形=")
打印(r)
打印("\n")

# 实心矩形（黄色）
r = 图形_填充(60, 60, 20, 20, 0xFFFF00)
打印("填充=")
打印(r)
打印("\n")

# 文字（青色）
r = 图形_文字(5, 85, "Hello", 0x00FFFF)
打印("文字=")
打印(r)
打印("\n")

# 刷新：headless 下导出 /tmp/gui_out.ppm
r = 图形_刷新()
打印("刷新=")
打印(r)
打印("\n")

# 保持：headless 下立即返回，不阻塞
r = 图形_保持()
打印("保持=")
打印(r)
打印("\n")

# 校验初始化返回值（应为 1）
如果 init_r == "0":
    打印("GUI初始化失败\n")
    打印("GUI测试失败\n")

打印("GUI测试结束\n")