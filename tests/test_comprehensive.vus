#// 综合测试：展示 VUS 语言主要特性

#// 1. 基本输出
打印("=== VUS 语言测试 ===\n")

#// 2. 变量
姓名 = "小明"
年龄 = 25
打印("姓名: ")
打印(姓名)
打印("\n")
打印("年龄: ")
打印(年龄)
打印("\n")

#// 3. 四则运算
a = 10
b = 3
打印("a + b = ")
打印(a + b)
打印("\n")
打印("a - b = ")
打印(a - b)
打印("\n")
打印("a * b = ")
打印(a * b)
打印("\n")
打印("a / b = ")
打印(a / b)
打印("\n")

#// 4. 比较
如果 a > b:
    打印("a 大于 b\n")
否则:
    打印("a 不大于 b\n")

#// 5. 循环
打印("1 到 5: ")
循环 i 从 1 到 5:
    打印(i)
打印("\n")

#// 6. 当循环
x = 1
当循环 x <= 3:
    打印(x)
    x = x + 1
打印("\n")

#// 7. 函数
定义 平方(n):
    返回 n * n

打印("5 的平方: ")
打印(平方(5))
打印("\n")

#// 8. 嵌套调用
打印("平方(2+3) = ")
打印(平方(2 + 3))
打印("\n")

#// 9. 引用计数（自动管理）
名字 = "世界"
问候 = "你好, " + 名字 + "!\n"
打印(问候)

#// 10. 综合
打印("\n=== 测试完成 ===\n")