#// 测试：图片 API + GIF 动画（headless）
#// 覆盖 图形_图片(.png / .svg / 缺失 / 非图片) 与 图形_动画_* 缺素材容错
#// PNG/SVG 成功=1、缺失/未知=0；GIF 无素材时返回 0 不崩溃。

打印("GUI媒体测试开始\n")

r = 图形_初始化(320, 230, "媒体测试")
打印("初始化=")
打印(r)
打印("\n")

# --- 图形_图片：PNG（复用 green.png/red.png）---
r = 图形_图片(10, 10, 120, 60, "green.png")
打印("PNG绿色=")
打印(r)
打印("\n")

r = 图形_图片(140, 10, 120, 60, "red.png")
打印("PNG红色=")
打印(r)
打印("\n")

# --- 图形_图片：SVG（a.svg）---
r = 图形_图片(10, 80, 120, 60, "a.svg")
打印("SVG图片=")
打印(r)
打印("\n")

# --- 图形_图片：缺失文件（应按扩展名 PNG 处理，解码失败返回 0）---
r = 图形_图片(140, 80, 80, 60, "不存在.png")
打印("缺失图片=")
打印(r)
打印("\n")

# --- 图形_图片：非图片文本文件（当作 PNG 解码失败，返回 0 不崩溃）---
r = 图形_图片(10, 150, 80, 40, "test_hello.vus")
打印("非图片文件=")
打印(r)
打印("\n")

# --- GIF 动画：无素材时全部容错返回 0，不崩溃 ---
r = 图形_动画_打开("动画", "不存在.gif")
打印("动画打开(缺失)=")
打印(r)
打印("\n")

r = 图形_动画_帧数("动画")
打印("动画帧数(未打开)=")
打印(r)
打印("\n")

r = 图形_动画_下一步("动画", 10, 180)
打印("动画下一步(未打开)=")
打印(r)
打印("\n")

r = 图形_动画_关闭("动画")
打印("动画关闭(未打开)=")
打印(r)
打印("\n")

图形_刷新()
打印("GUI媒体测试结束\n")