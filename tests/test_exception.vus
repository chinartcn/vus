#// 测试：异常处理完整流程
#// 验证 try/except/throw 的多种场景

打印("=== 异常处理测试 ===\n")

#// 场景1：基本抛出和捕获
定义 测试1():
    尝试:
        抛出 "错误1"
        打印("不应打印: 抛出后\n")
    捕获:
        打印("捕获到异常\n")
    打印("异常处理后继续\n")

测试1()

#// 场景2：没有异常的 try 块
定义 测试2():
    尝试:
        打印("try 块正常执行\n")
    捕获:
        打印("不应打印: 没有异常\n")
    打印("正常完成\n")

测试2()

#// 场景3：嵌套异常处理
定义 测试3():
    尝试:
        打印("外层 try 开始\n")
        尝试:
            抛出 "内层错误"
        捕获:
            打印("内层捕获到异常\n")
        打印("外层 try 继续\n")
    捕获:
        打印("不应打印: 外层捕获\n")

测试3()

打印("异常处理测试完成\n")