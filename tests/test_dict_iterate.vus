#// 字典遍历接口端到端测试：
#//   1) 循环 键 在 字典 —— 直接遍历键（字典容器）
#//   2) 字典_项(字典) —— 遍历键值对（每项为 [键, 值] 双元素列表，下标 [0]/[1]）
打印("=== 字典遍历测试开始 ===\n")

# 构造字典（JSON_解析 得到 VusObject* TYPE_DICT 容器）
d = JSON_解析("{\"甲\":\"1\",\"乙\":\"2\",\"丙\":\"3\"}")

打印("--- 1) 循环 键 在 字典 ---\n")
序号 = 0
循环 键 在 d:
    序号 = 序号 + 1
    打印(键)
    打印("=")
    打印(字典_取值(d, 键))
    打印("\n")
打印("键数=")
打印(转文本(序号))
打印("\n")

打印("--- 2) 字典_项 遍历键值对 ---\n")
对数量 = 0
循环 对 在 字典_项(d):
    对数量 = 对数量 + 1
    打印(对[0])
    打印(":")
    打印(对[1])
    打印("\n")
打印("项数=")
打印(转文本(对数量))
打印("\n")

打印("=== 字典遍历测试完成 ===\n")