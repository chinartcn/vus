#// 测试：旧式标准库接线（设计文档 §10.1 核心库）
#// 旧式名称应映射到 文本_*/列表_*/字典_*/文件_*/日期_* 现代实现

#// —— 字符串 ——
打印("长度 = " + 长度("你好"))                 #// 6（UTF-8 字节长度，与 文本_长度 一致）
打印("拼接 = " + 拼接("你好", "世界"))        #// 你好世界
行 = 分割("a,b,c", ",")
打印("分割[0] = " + 取元素(行, 0))            #// a
打印("分割长度 = " + 列表长度(行))            #// 3
打印("取子串 = " + 取子串("Hello", 0, 3))     #// Hel
打印("替换 = " + 替换("a-b-c", "-", "+"))     #// a+b+c

#// —— 数字 ——
打印("取整 = " + 取整("3.7"))                 #// 3
随机数 = 取随机数(1, 2)
打印("取随机数 = " + 随机数)                  #// 1 或 2

#// —— 列表 ——
列表 = 创建列表("a", "b")
添加元素(列表, "c")
打印("列表长度 = " + 列表长度(列表))          #// 3
打印("取元素(1) = " + 取元素(列表, 1))        #// b
打印("长度(列表) = " + 长度(列表))            #// 3
删除元素(列表, 0)
打印("删除后长度 = " + 列表长度(列表))        #// 2

定义 打印行(元素):
    打印("遍历: " + 元素)
遍历列表(列表, 打印行)

#// —— 字典 ——
字典 = 创建字典()
字典设值(字典, "k1", "v1")
字典设值(字典, "k2", "v2")
打印("字典取值 = " + 字典取值(字典, "k2"))    #// v2
打印("字典长度 = " + 字典长度(字典))          #// 2
打印("长度(字典) = " + 长度(字典))            #// 2
字典删除(字典, "k1")
打印("删除后字典长度 = " + 字典长度(字典))    #// 1

#// —— 文件 ——
写入文件("legacy_tmp.txt", "旧式标准库测试")
打印("文件是否存在 = " + 文件是否存在("legacy_tmp.txt"))   #// 1（桌面同 文件_存在）
追加文件("legacy_tmp.txt", "\n第二行")
打印("读取文件 = " + 读取文件("legacy_tmp.txt"))
删除文件("legacy_tmp.txt")
打印("删除后存在 = " + 文件是否存在("legacy_tmp.txt"))     #// 0

#// —— 时间 / 调试 / 断言 ——
打印("当前时间 = " + 当前时间())
调试输出("仅调试模式可见")
断言(1 + 1 == 2, "数学错误")
打印("断言通过")