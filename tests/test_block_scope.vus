#// 词法作用域 / 块级作用域 验证
#// 1) 单块内使用 → 块级局部（块外不可见）
如果 1 == 1:
    块内临时 = "block-local"
    打印(块内临时 .. "\n")

#// 2) 分支内赋值、块外读取 → 提升为函数级（兼容既有写法）
如果 1 == 1:
    提升名 = "A"
否则:
    提升名 = "B"
打印(提升名 .. "\n")

#// 3) 循环体块级临时
循环 i 从 1 到 2:
    循环临时 = "iter-" .. 转文本(i)
    打印(循环临时 .. " ")
打印("\n")

#// 4) 循环变量为各自的块级名字，同名复用互不干扰
循环 j 从 1 到 2:
    打印("j1=" .. j .. " ")
循环 j 从 3 到 3:
    打印("j2=" .. j .. " ")
打印("\n")

#// 5) 分支内赋值、函数体返回读取 → hoist 为函数级
定义 测试函数():
    a = 1
    如果 a > 0:
        b = a + 1
    返回 b
打印(测试函数() .. "\n")

#// 5.1) 函数内仅单个块使用的名字 → 真块级局部（_sN 后缀，C 块作用域）
定义 单块函数():
    如果 1 == 1:
        独占名 = "inner-block"
        打印(独占名 .. "\n")
单块函数()

#// 6) 函数内改全局变量（P1 回归）：全局名不遮蔽
全局总量 = 100
定义 改():
    全局 全局总量
    全局总量 = 200
改()
打印(全局总量 .. "\n")