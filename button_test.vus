#// 按钮交互测试（验证边缘触发）
打印("按钮测试启动\n")

图形_初始化(320, 200, "VUS 按钮测试")

计数 = 0
运行中 = 1

当循环 运行中 == 1:
    图形_取事件()
    图形_填充(0, 0, 320, 200, 0xF0F0F0)

    图形_标签("标题", 80, 30, "点我试试", 0x12418C)
    图形_标签("计数", 80, 70, "点击次数: " .. 计数, 0x000000)

    图形_按钮("b1", 40, 120, 70, 40, "点我")
    图形_按钮("b2", 130, 120, 70, 40, "再点")
    图形_按钮("退出", 220, 120, 70, 40, "退出")

    如果 图形_按钮点击("b1"):
        计数 = 计数 + 1
        打印("点击了 点我，次数=")
        打印(计数)
        打印("\n")

    如果 图形_按钮点击("b2"):
        计数 = 计数 + 1
        打印("点击了 再点，次数=")
        打印(计数)
        打印("\n")

    如果 图形_按钮点击("退出"):
        运行中 = 0
        打印("退出\n")

    图形_刷新()

图形_保持()
打印("测试结束\n")
