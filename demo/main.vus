#// 这是一个完整的 VUS 示例程序（函数风格，中文别名）

// ============ 导入 ============
导入 "工具.vus"

// ============ 变量 ============
欢迎语 = "欢迎使用 VUS"
版本号 = 0.1

// ============ 函数 ============
定义 显示菜单():
    打印("=== " .. 欢迎语 .. " ===")
    打印("版本：" .. 转文本(版本号))
    打印("1. 计算器")
    打印("2. 待办清单")
    打印("3. 退出")
    返回 输入("请选择：")

定义 计算器():
    a = 转数字(输入("第一个数："))
    b = 转数字(输入("第二个数："))
    打印("结果：" .. 转文本(a + b))

定义 打印事项(事项文本):
    打印("- " .. 事项文本)

定义 待办清单():
    事项 = 创建列表()
    当循环 真:
        打印("\n当前清单：")
        遍历列表(事项, 打印事项)
        操作 = 输入("添加/删除/退出：")
        如果 操作 == "添加":
            添加元素(事项, 输入("事项内容："))
        否则如果 操作 == "删除":
            删除元素(事项, 转数字(输入("索引：")))
        否则:
            跳出

// ============ 主程序 ============
尝试:
    当循环 真:
        选择 = 显示菜单()
        如果 选择 == "1":
            计算器()
        否则如果 选择 == "2":
            待办清单()
        否则如果 选择 == "3":
            打印("再见！")
            退出()
        否则:
            打印("无效选择，请重新输入")
捕获 KeyboardInterrupt:
    打印("用户中断")
    退出()
捕获:
    打印("未知异常")
    退出()