#// 工具库单元测试

导入 "libs/工具.vus"

// 测试求和
定义 测试求和():
    断言(求和(1, 2) == 3, "1 + 2 应等于 3")
    断言(求和(-1, 1) == 0, "-1 + 1 应等于 0")
    断言(求和(0, 0) == 0, "0 + 0 应等于 0")
    打印("测试求和：通过")

// 测试求差
定义 测试求差():
    断言(求差(5, 3) == 2, "5 - 3 应等于 2")
    断言(求差(3, 5) == -2, "3 - 5 应等于 -2")
    断言(求差(0, 0) == 0, "0 - 0 应等于 0")
    打印("测试求差：通过")

// 测试问候
定义 测试问候():
    断言(问候() == "你好，世界！", "默认问候应包含「世界」")
    断言(问候("张三") == "你好，张三！", "自定义问候应包含姓名")
    打印("测试问候：通过")

// 测试偶数判断
定义 测试是偶数():
    断言(是偶数(2) == 真, "2 应为偶数")
    断言(是偶数(3) == 假, "3 应为奇数")
    断言(是偶数(0) == 真, "0 应为偶数")
    打印("测试是偶数：通过")

// 运行所有测试
测试求和()
测试求差()
测试问候()
测试是偶数()
打印("\n所有测试通过！")