# =============================================================================
# vus-full.vus — VUS 完整自举编译器
#
# 将 VUS 源码编译为 C 代码，然后调用 GCC 编译为可执行文件。
# 相比 vus-mini 扩展：浮点/十六进制/二进制数字、\u 转义、// 注释、
# 位运算(& | ^ ~ << >>)、下标赋值、日期/时钟/日志/TUI/网络内建。
#
# 用法: vus-full <输入.vus> [输出根名] [rt目录] [libvus_rt.a路径]
#   默认 rt目录=rt  libvus_rt.a=build/libvus_rt.a
#
# 语法子集（本编译器自身也必须能用 vus-mini 编译，故只用其支持构造）：
#   - 块用 冒号 + 缩进，无 则/结束 标记
#   - for 循环: 循环 变量 从 起始 到 终止:   （含终止值）
#   - 条件: 如果 cond: / 否则如果 cond: / 否则:
#   - 函数定义: 定义 名(参数):
#   - 无 非 运算符、无多行表达式
#
# 设计要点：
#   - VUS 函数内赋值一律是局部变量（无法重绑全局），故所有可变状态存放
#     在全局列表里（用 列表_追加 / 列表_取 修改读取），标量索引用"单元格
#     列表"（追加即更新，取末元素即当前值）。
#   - 词法分析是迭代的，直接放顶层代码（顶层赋值即全局，可自由重绑）。
#   - 语法分析是递归的，用 idx_cell 贯穿 token 位置。
# =============================================================================

# ==================== Token 类型常量 ====================
TOK_EOF = 0
TOK_ID = 1
TOK_NUM = 2
TOK_STR = 3
TOK_NEWLINE = 4
TOK_INDENT = 5
TOK_DEDENT = 6
TOK_LPAREN = 10
TOK_RPAREN = 11
TOK_LBRACKET = 12
TOK_RBRACKET = 13
TOK_LBRACE = 14
TOK_RBRACE = 15
TOK_COMMA = 16
TOK_COLON = 17
TOK_DOT = 18
TOK_PLUS = 20
TOK_MINUS = 21
TOK_STAR = 22
TOK_SLASH = 23
TOK_PERCENT = 24
TOK_AMPERSAND = 25
TOK_PIPE = 26
TOK_CARET = 27
TOK_TILDE = 28
TOK_SHL = 29
TOK_SHR = 30
TOK_ASSIGN = 40
TOK_EQ = 41
TOK_NEQ = 42
TOK_LT = 43
TOK_GT = 44
TOK_LE = 45
TOK_GE = 46
TOK_CONCAT = 47

# 关键字（与 C-VUS 对齐）
KW_DEF = 50
KW_IF = 51
KW_ELIF = 52
KW_ELSE = 53
KW_FOR = 54
KW_WHILE = 55
KW_RETURN = 56
KW_TRUE = 57
KW_FALSE = 58
KW_NULL = 59
KW_AND = 60
KW_OR = 61
KW_NOT = 62
KW_GLOBAL = 64
KW_BREAK = 65
KW_CONTINUE = 66
KW_IN = 67
KW_TO = 68
KW_FROM = 71

